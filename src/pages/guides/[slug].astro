---
import Base from '../../layouts/Base.astro';
import ProductPicks from '../../components/ProductPicks.astro';
import { products, productLink, searchLink, outboundRel } from '../../config/affiliate';
import { guides, SRC, REVIEWED } from '../../lib/guides';
import { guidePublished } from '../../lib/lastmod';
import { editorialTeam, publisherRef } from '../../lib/schema';
export function getStaticPaths(){ return guides.map(g=>({params:{slug:g.slug},props:{g}})); }
const { g } = Astro.props as any; const rev = g.reviewed || REVIEWED; const revText = new Date(rev+'T12:00:00Z').toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}); const site = Astro.site!.href; const url = new URL(Astro.url.pathname, site).href;
const strip=(s:string)=>s.replace(/<[^>]+>/g,'').replace(/\[\d+\]/g,'');
const keys = Object.keys(SRC);
const img = new URL('/og/guides.png', site).href;
const ld=[{"@context":"https://schema.org","@type":"Article","@id":`${url}#article`,headline:g.title,description:g.desc,url,inLanguage:"en-US",image:img,datePublished:guidePublished(g),dateModified:rev,author:editorialTeam,publisher:publisherRef,mainEntityOfPage:url,isPartOf:{"@type":"WebSite",name:"MySpaFilter",url:site}},
{"@context":"https://schema.org","@type":"FAQPage",mainEntity:g.faq.map(([q,a]:any)=>({"@type":"Question",name:q,acceptedAnswer:{"@type":"Answer",text:strip(a)}}))},
{"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[{"@type":"ListItem",position:1,name:"Home",item:site},{"@type":"ListItem",position:2,name:"Guides",item:new URL('/guides/',site).href},{"@type":"ListItem",position:3,name:g.title,item:url}]}];
const RELATED: Record<string, string[]> = {
  'how-to-find-your-spa-filter-size': ['open-end-vs-threaded-hot-tub-filters','hot-spring-filter-sizes-by-collection','caldera-filter-bottom-fittings','why-same-size-spa-filters-have-different-square-feet'],
  'oem-vs-unicel-vs-pleatco-spa-filters': ['how-filbur-unicel-and-pleatco-numbers-compare','sundance-and-jacuzzi-look-alike-filters','why-same-size-spa-filters-have-different-square-feet'],
  'why-same-size-spa-filters-have-different-square-feet': ['open-end-vs-threaded-hot-tub-filters','how-filbur-unicel-and-pleatco-numbers-compare','sundance-and-jacuzzi-look-alike-filters'],
  'how-to-clean-a-hot-tub-filter': ['how-to-install-a-hot-tub-filter','clogged-or-missing-hot-tub-filter','spas-that-use-more-than-one-filter'],
  'how-often-to-replace-hot-tub-filter': ['clogged-or-missing-hot-tub-filter','signs-your-hot-tub-filter-is-bad','spas-that-use-more-than-one-filter'],
  'signs-your-hot-tub-filter-is-bad': ['clogged-or-missing-hot-tub-filter','how-to-install-a-hot-tub-filter','hot-tub-flow-error-codes-and-your-filter'],
  'hot-tub-flow-error-codes-and-your-filter': ['clogged-or-missing-hot-tub-filter','how-to-install-a-hot-tub-filter','how-to-clean-a-hot-tub-filter'],
  'how-often-to-clean-hot-tub-filter': ['how-to-clean-a-hot-tub-filter','clogged-or-missing-hot-tub-filter','how-to-install-a-hot-tub-filter'],
};
const seen = new Set<string>([g.slug]);
const others: typeof guides = [];
for (const s of [...(g.related || []), ...(RELATED[g.slug] || [])]) {
  const x = guides.find((y) => y.slug === s);
  if (x && !seen.has(x.slug)) { others.push(x); seen.add(x.slug); }
}
for (const x of guides) { if (others.length >= 6) break; if (!seen.has(x.slug)) { others.push(x); seen.add(x.slug); } }
const leadPick = (() => {
  for (const group of g.picks || []) {
    const key = group.keys?.find((k: string) => products[k]);
    if (key) { const p = products[key]; return { kind: 'direct' as const, href: productLink(key), name: p.name, says: p.says }; }
    const search = group.search?.[0];
    if (search) { const [name, query, why] = search; return { kind: 'search' as const, href: searchLink(query), name, says: why || '' }; }
  }
  return null;
})();
---
<Base title={`${g.title} | MySpaFilter`} description={g.desc} jsonld={ld} ogType="article" modified={rev}>
<p class="crumbs"><a href="/">Home</a> › <a href="/guides/">Guides</a></p>
<article><h1>{g.title}</h1>
<p class="crumbs byline">By <a href="/about/" rel="author">MySpaFilter Editorial Team</a> · Last reviewed <time datetime={rev}>{revText}</time></p>
<section class="card answer"><div class="kicker">Short answer</div><p style="font-size:1.12rem;margin:.4rem 0 0" set:html={g.answer} /></section>
{leadPick && <section class="card quick-pick"><p><strong>One product this answer points to</strong></p><p><strong>{leadPick.name}</strong></p>{leadPick.says && <p>{leadPick.says}</p>}<div class="buy"><a class="btn" href={leadPick.href} rel={outboundRel} target="_blank">{leadPick.kind === 'direct' ? 'See on Amazon' : 'Search on Amazon'}<span class="sr"> — {leadPick.name} (opens in a new tab)</span></a></div><p class="amz-note" data-amazon-disclosure><small>As an Amazon Associate I earn from qualifying purchases. {leadPick.kind === 'direct' ? 'See on Amazon opens a listing whose title we checked. The line under the name repeats only that title.' : 'Search on Amazon opens an Amazon search for this name, not one listing we pre-checked.'} See our <a href="/affiliate-disclosure/">affiliate disclosure</a>.</small></p><p><a href="#picks">Products we checked</a></p></section>}
<Fragment set:html={g.body} />
{g.picks && <ProductPicks id="picks" groups={g.picks} heading={g.pickHeading || 'Products worth considering'} />}
<h2 data-reveal>FAQ</h2>{g.faq.map(([q,a]:any)=><details class="card"><summary><strong>{q}</strong></summary><p>{a}</p></details>)}
<aside class="card" id="how-we-review" style="margin-top:2.2rem"><h2 style="margin-top:0;font-size:1.2rem">How we research and review</h2><p style="margin:.3rem 0">The MySpaFilter Editorial Team writes each guide from published manufacturer, Unicel, Pleatco, CDC and CPSC sources, linked below, and checks that every number or safety claim traces to one of them. Guides are re-read when a source changes or a reader reports a problem; the review date above is the last time we did. Retailer commissions never change the cross-reference data. Product links are Amazon affiliate links, which we disclose. Details: <a href="/about/#methodology">our methodology and corrections policy</a>.</p></aside>
<h2>Sources</h2><ol>{keys.map(k=>g.src.includes(k)||g.answer.includes(`#src-${k}`)||g.body.includes(`#src-${k}`)?<li id={`src-${k}`} value={keys.indexOf(k)+1}><a href={SRC[k].u} rel="nofollow">{SRC[k].t}</a></li>:null)}</ol>
<p><small>This guide summarizes published manufacturer and public-health guidance; always follow your own spa’s owner’s manual. See our <a href="/disclaimer/">disclaimer</a>.</small></p>
</article>
<h2>More guides</h2><ul>{others.map((x:any)=><li><a href={`/guides/${x.slug}/`}>{x.title}</a></li>)}</ul>
</Base>
