---
import Base from '../layouts/Base.astro';
import { brands, filters, allParts, brandIndexable } from '../lib/data';
import { guides } from '../lib/guides';
const parts = [...allParts().keys()];
const bl = brands().map(b=>[b.slug,b.name.toLowerCase()]);
const bs = brands().filter(b=>brandIndexable(b.slug));
---
<Base title="Page not found | MySpaFilter" description="That page does not exist. Search for a spa filter by part number or browse by brand and guide." noindex canonical={false}>
<h1>Page not found</h1>
<p>We could not find that page. It may have moved, or the address may be mistyped. Search by part number or spa brand below, or pick a brand or guide.</p>
<form class="search card" id="f" role="search" style="border:1px solid var(--bd)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="q" class="wide" placeholder="e.g. 6540-476, C-8326, Jacuzzi" autocomplete="off" aria-label="Part number or spa brand" style="border:0;flex:1;min-width:0;outline:0"><button class="btn" id="go">Find filter</button></form>
<p id="msg" aria-live="polite" style="min-height:1.4em"></p>
<h2>Browse by spa brand</h2>
<ul class="grid">{bs.map(b=><li class="card"><a href={`/${b.slug}/`} style="font-weight:700">{b.name}</a><p class="crumbs">{filters.filter(f=>f.brandSlug===b.slug).length} cartridges</p></li>)}</ul>
<h2>Guides</h2>
<ul>{guides.slice(0,8).map(g=><li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>)}</ul>
<p><a href="/guides/">All guides →</a> · <a href="/guides/open-end-vs-threaded-hot-tub-filters/">Open-end vs threaded filters</a> · <a href="/guides/hot-spring-filter-sizes-by-collection/">Hot Spring sizes</a> · <a href="/size/">Find a filter by size</a> · <a href="/data/">Full cartridge dataset</a> · <a href="/">Home</a></p>
<script define:vars={{parts,bl}}>
const q=document.getElementById('q'),m=document.getElementById('msg');const s=v=>v.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const go=e=>{e&&e.preventDefault();const k=s(q.value);if(!k)return;const br=bl.find(([sl,n])=>sl===k||n===q.value.trim().toLowerCase());if(br){location.href='/'+br[0]+'/';return}if(parts.includes(k)){location.href='/filter/'+k+'/';return}const h=parts.filter(p=>p.includes(k));if(h.length===1){location.href='/filter/'+h[0]+'/';return}m.innerHTML=h.length?'Did you mean: '+h.map(p=>`<a href="/filter/${p}/">${p.toUpperCase()}</a>`).join(', '):'No match for that number. Try the <a href="/size/">size lookup</a>.';};
document.getElementById('f').onsubmit=go;
</script>
</Base>
