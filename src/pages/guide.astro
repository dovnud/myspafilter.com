---
import Page from '../components/Page.astro';
import ProductPicks from '../components/ProductPicks.astro';
import { filters, partLabel } from '../lib/data';
const ver = filters.filter(f=>f.status==='verified').length;
const examples: [string, string, string][] = [];
const seen = new Set<string>();
for (const f of filters) {
  const pk = partLabel(f);
  if (!pk || seen.has(f.brandSlug)) continue;
  seen.add(f.brandSlug);
  examples.push([`${f.brand} ${pk}`, `${pk} spa filter`, `${(f.dimensions as any).diameterText} × ${(f.dimensions as any).lengthText}`]);
  if (examples.length >= 4) break;
}
