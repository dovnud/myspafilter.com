---
import Base from '../layouts/Base.astro';
import { brands, filters, allParts, brandIndexable } from '../lib/data';
import { guides } from '../lib/guides';
import SpotlightCard from '../components/rb/SpotlightCard.jsx';
import Magnet from '../components/rb/Magnet.jsx';
import { organization } from '../lib/schema';
import { fileDate, dataDate } from '../lib/lastmod';
const site = Astro.site!.href;
// Whirlpool arms: logarithmic-ish spiral drawn in circle space (r<=92), squashed to the end-cap ellipse by a wrapper scale.
const arm=(a0,r0,r1,sw)=>{const pts=Array.from({length:9},(_,k)=>{const t=k/8,r=r0+(r1-r0)*t,a=a0+sw*Math.pow(t,.8);return [r*Math.cos(a),r*Math.sin(a)]});let d=`M${pts[0].map(n=>n.toFixed(1)).join(' ')}`;for(let i=0;i<pts.length-1;i++){const p0=pts[i-1]||pts[i],p1=pts[i],p2=pts[i+1],p3=pts[i+2]||p2;const c1=[p1[0]+(p2[0]-p0[0])/6,p1[1]+(p2[1]-p0[1])/6],c2=[p2[0]-(p3[0]-p1[0])/6,p2[1]-(p3[1]-p1[1])/6];d+=`C${[...c1,...c2,...p2].map(n=>n.toFixed(1)).join(' ')}`}return d};
const armsA=Array.from({length:12},(_,i)=>arm(i/12*Math.PI*2,35,92,1.35));
const armsB=Array.from({length:6},(_,i)=>arm(i/6*Math.PI*2+.3,46,84,-1.1));
const parts = [...allParts().keys()];
const bl = brands().map(b=>[b.slug,b.name.toLowerCase()]);
---
<Base title="Spa Filter & Hot Tub Filter Cross Reference | MySpaFilter" description="Find the right hot tub filter: OEM part numbers cross-referenced to Unicel, Pleatco and Filbur equivalents for Hot Spring, Caldera, Hot Spot, Solana, Sundance, Jacuzzi, Bullfrog, Cal Spas, Master Spas, Marquis, Dimension One, Softub and Intex, with cited sources."
 jsonld={[{"@context":"https://schema.org","@type":"WebSite","@id":`${site}#website`,name:"MySpaFilter",url:site,inLanguage:"en-US",publisher:{"@id":organization["@id"]}},{"@context":"https://schema.org",...organization},{"@context":"https://schema.org","@type":"WebPage",url:site,name:"Spa Filter & Hot Tub Filter Cross Reference",dateModified:[fileDate('src/pages/index.astro'),dataDate()].sort().at(-1),isPartOf:{"@id":`${site}#website`}}]}>
<section class="hero">
<svg class="ripples" viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" fill="none" stroke="#8fb9b0" stroke-opacity=".16">{[60,110,170,240,320,410].map(r=><ellipse cx="690" cy="40" rx={r*1.25} ry={r*.8}/>)}</svg>
<div>
<p class="eyebrow">Spa &amp; hot tub filter cross-reference</p>
<h1>Read the end cap.<br><em>We'll find the cartridge.</em></h1>
<p class="lede">Type the number molded into your old filter — a Sundance <code>6540-476</code>, a Unicel <code>C-8326</code>, a Pleatco <code>PTL47W</code> — or a spa brand. You get the matching OEM, Unicel, Pleatco and Filbur numbers plus diameter, length and fittings to check against a tape measure.</p>
<form class="search" id="f" role="search"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="q" placeholder="e.g. 6540-476, C-8326, Jacuzzi" autocomplete="off" aria-label="Part number or spa brand"><button class="btn" id="go">Find filter</button></form>
<p id="msg" aria-live="polite"></p>
<div class="stats"><span><b>{filters.length}</b>cartridges</span><span><b>{parts.length}</b>part numbers</span><span><b>{brands().length}</b>spa brands</span><Magnet client:visible padding={40} magnetStrength={6} maxOffset={6}><a class="btn ghost" href="/size/">No number? Search by size →</a></Magnet></div>
</div>
<figure class="endcap" aria-labelledby="endcap-cap">
<svg viewBox="0 0 240 150" fill="none" stroke="#e8d6b5" stroke-width="1.4" role="img" aria-label="Illustration of a filter end cap with the part number C-8326 printed in the center, surrounded by slowly swirling pleats">
<g aria-hidden="true">
<ellipse cx="120" cy="75" rx="100" ry="62"/>
<g transform="translate(120 75) scale(1 .62)">
<g class="wp-ripples" stroke="#8fb9b0" stroke-width="1.2" vector-effect="non-scaling-stroke"><circle class="rp rp1" r="92" vector-effect="non-scaling-stroke"/><circle class="rp rp2" r="92" vector-effect="non-scaling-stroke"/><circle class="rp rp3" r="92" vector-effect="non-scaling-stroke"/></g>
<g class="wp-spin wp-b" stroke="#8fb9b0" stroke-opacity=".3" stroke-width="1" stroke-linecap="round">{armsB.map(d=><path d={d} vector-effect="non-scaling-stroke"/>)}</g>
<g class="wp-spin wp-a" stroke="#d6e7e0" stroke-opacity=".34" stroke-width="1.3" stroke-linecap="round">{armsA.map(d=><path d={d} vector-effect="non-scaling-stroke"/>)}</g>
</g>
<ellipse cx="120" cy="75" rx="34" ry="21" fill="#0b3c40" stroke-opacity=".75"/>
</g>
<text x="120" y="80" fill="#fff" stroke="none" font-family="ui-monospace,monospace" font-size="13" font-weight="600" text-anchor="middle">C-8326</text></svg><figcaption id="endcap-cap">The part number is usually stamped or printed on the top end cap, or on a label inside the pleats.</figcaption></figure>
<style>
.endcap .wp-spin,.endcap .rp{transform-origin:0 0;will-change:transform}
.endcap .wp-a{animation:wp-cw 48s linear infinite}
.endcap .wp-b{animation:wp-ccw 80s linear infinite}
.endcap .rp{fill:none;opacity:0;transform:scale(.37);animation:wp-ripple 9s ease-out infinite}
.endcap .rp2{animation-delay:-3s}.endcap .rp3{animation-delay:-6s}
@keyframes wp-cw{to{transform:rotate(360deg)}}
@keyframes wp-ccw{to{transform:rotate(-360deg)}}
@keyframes wp-ripple{0%{transform:scale(.37);opacity:0}15%{opacity:.4}100%{transform:scale(1);opacity:0}}
@media (prefers-reduced-motion:reduce){.endcap .wp-spin,.endcap .rp{animation:none;will-change:auto}.endcap .rp{opacity:.22}.endcap .rp1{transform:scale(.55)}.endcap .rp2{transform:scale(.75)}.endcap .rp3{transform:scale(.95)}}
</style>
</section>
<h2 class="rule" data-reveal>Browse by spa brand</h2>
<ul class="grid">{brands().filter(b=>brandIndexable(b.slug)).map((b,i)=>{const l=filters.filter(f=>f.brandSlug===b.slug);const c=['#135e63','#9c4b22','#4f7f6e','#2c5d7c','#b38a3e','#0b3c40'][i%6];return <li data-reveal><SpotlightCard client:visible className="card" theme="light" spotlightColor="#135e63" intensity={0.5} proximity={0}><a class="tile" style={`--c:${c}`} href={`/${b.slug}/`}><b>{b.name}</b><small>{l.length} cartridge{l.length===1?"":"s"} · {l.filter(f=>f.status==='verified').length} with cited sources</small><span class="go">See {b.name} filters →</span></a></SpotlightCard></li>})}</ul>
<h2 class="rule" data-reveal>Guides worth reading first</h2>
<ul class="grid">{['how-to-find-your-spa-filter-size','hot-spring-filter-sizes-by-collection','open-end-vs-threaded-hot-tub-filters','caldera-filter-bottom-fittings','how-often-to-replace-hot-tub-filter','intex-and-bestway-inflatable-spa-filters'].map(s=>guides.find(g=>g.slug===s)!).map(g=><li class="card" data-reveal><a href={`/guides/${g.slug}/`} style="font-weight:650">{g.title}</a></li>)}</ul><p><a href="/guides/">All {guides.length} guides</a>, including Bullfrog, Master Spas Eco-Pur, Sundance look-alikes, and how Filbur, Unicel and Pleatco numbers line up.</p>
<h2 class="rule" data-reveal>How we match a cartridge</h2>
<div class="feat" data-reveal>
<div class="card"><span class="n">01</span><h3>Cross-referenced</h3><p>Spa makers, Unicel, Pleatco and Filbur number the same cartridge differently. We match them using the published tables.</p></div>
<div class="card"><span class="n">02</span><h3>Cited sources</h3><p>Every row links the catalog page, and anything unconfirmed is clearly flagged so you can check it yourself.</p></div>
<div class="card"><span class="n">03</span><h3>Measure to confirm</h3><p>No readable number? Use the <a href="/guide/">measuring guide</a> or <a href="/size/">size lookup</a>.</p></div>
</div>
<script define:vars={{parts,bl}}>
const q=document.getElementById('q'),m=document.getElementById('msg');const s=v=>v.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const go=e=>{e&&e.preventDefault();const k=s(q.value);if(!k)return;const br=bl.find(([sl,n])=>sl===k||n===q.value.trim().toLowerCase());if(br){location.href='/'+br[0]+'/';return}if(parts.includes(k))location.href='/filter/'+k+'/';else{const h=parts.filter(p=>p.includes(k)).slice(0,6);m.innerHTML=h.length?'Did you mean: '+h.map(p=>`<a href="/filter/${p}/">${p.toUpperCase()}</a>`).join(', '):'No match for that number. Try the size lookup.';}};
document.getElementById('f').onsubmit=go;
</script>
</Base>
