---
import Base from '../layouts/Base.astro';
import { brands, filters, allParts } from '../lib/data';
const site = Astro.site!.href;
const parts = [...allParts().keys()];
---
<Base title="Spa Filter & Hot Tub Filter Cross Reference | MySpaFilter" description="Find the right hot tub filter: OEM part numbers cross-referenced to Unicel and Pleatco equivalents for Sundance, Jacuzzi, Hot Spring and Caldera, with cited sources."
 jsonld={[{"@context":"https://schema.org","@type":"WebSite",name:"MySpaFilter",url:site}]}>
<section class="hero"><h1>Find the right hot tub filter, with sources</h1>
<p>Look up {filters.length} spa filter cartridges by OEM, Unicel, or Pleatco number. Each one comes with dimensions, fittings, and a page citation from the manufacturer catalogs.</p>
<label for="q"><strong>Part number</strong></label><br><input id="q" class="wide" placeholder="e.g. 6540-476 or C-8326" autocomplete="off"> <a class="btn" id="go" href="#">Find</a> <a class="btn" style="background:var(--ac2)" href="/size/">Lookup by size</a>
<p id="msg" class="crumbs"></p></section>
<h2>Browse by brand</h2>
<ul class="grid">{brands().map(b=>{const l=filters.filter(f=>f.brandSlug===b.slug);return <li class="card"><a href={`/${b.slug}/`} style="font-weight:700;font-size:1.1rem">{b.name}</a><p class="crumbs">{l.length} cartridges · {l.filter(f=>f.status==='verified').length} fully cited</p></li>})}</ul>
<h2>How this works</h2><p>Spa makers, Unicel, and Pleatco each number the same cartridge differently. We match those numbers using the published cross-reference tables and show the source page, so you can check any claim yourself. Read the <a href="/guide/">measuring guide</a> if your old filter has no readable number.</p>
<script define:vars={{parts}}>
const q=document.getElementById('q'),m=document.getElementById('msg');const s=v=>v.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
const go=e=>{e&&e.preventDefault();const k=s(q.value);if(parts.includes(k))location.href='/filter/'+k+'/';else{const h=parts.filter(p=>p.includes(k)).slice(0,6);m.innerHTML=h.length?'Did you mean: '+h.map(p=>`<a href="/filter/${p}/">${p.toUpperCase()}</a>`).join(', '):'No match. Try the size lookup.';}};
document.getElementById('go').onclick=go;q.onkeydown=e=>{if(e.key==='Enter')go(e)};
</script>
</Base>
