---
import Base from '../layouts/Base.astro';
import { brands, filters, allParts, brandIndexable, modelHref, partLabel, slug } from '../lib/data';
import { indexParts } from '../lib/xref.mjs';
import { guides } from '../lib/guides';
import { organization } from '../lib/schema';
import { fileDate, dataDate } from '../lib/lastmod';
const site = Astro.site!.href;
// Whirlpool arms: logarithmic-ish spiral drawn in circle space (r<=92), squashed to the end-cap ellipse by a wrapper scale.
const arm=(a0,r0,r1,sw)=>{const pts=Array.from({length:9},(_,k)=>{const t=k/8,r=r0+(r1-r0)*t,a=a0+sw*Math.pow(t,.8);return [r*Math.cos(a),r*Math.sin(a)]});let d=`M${pts[0].map(n=>n.toFixed(1)).join(' ')}`;for(let i=0;i<pts.length-1;i++){const p0=pts[i-1]||pts[i],p1=pts[i],p2=pts[i+1],p3=pts[i+2]||p2;const c1=[p1[0]+(p2[0]-p0[0])/6,p1[1]+(p2[1]-p0[1])/6],c2=[p2[0]-(p3[0]-p1[0])/6,p2[1]-(p3[1]-p1[1])/6];d+=`C${[...c1,...c2,...p2].map(n=>n.toFixed(1)).join(' ')}`}return d};
const armsA=Array.from({length:12},(_,i)=>arm(i/12*Math.PI*2,35,92,1.35));
const armsB=Array.from({length:6},(_,i)=>arm(i/6*Math.PI*2+.3,46,84,-1.1));
const parts = new Set(allParts().keys());
// Search index: one row per cartridge, only fields already in filters.json.
const sdata = { brands: brands().map(b=>[b.slug,b.name]), rows: filters.map(f=>{ const e=f.equivalents||{}; const d:any=f.dimensions; const i=indexParts([f.oem,f.oemAll,e.unicel,e.pleatco,e.filbur,f.searchTerm]); const p=partLabel(f)||''; return { h:modelHref(f), n:`${f.brand} ${f.model}`, s:f.series, p, pp: parts.has(slug(p)) ? `/filter/${slug(p)}/` : '', d:d.diameterIn, l:d.lengthIn, dt:d.diameterText, lt:d.lengthText, wholes:i.wholes, tokens:i.tokens }; }) };
---
<Base title="Spa Filter & Hot Tub Filter Cross Reference | MySpaFilter" description="Find the right hot tub filter: OEM part numbers cross-referenced to Unicel, Pleatco and Filbur equivalents for Hot Spring, Caldera, Hot Spot, Solana, Sundance, Jacuzzi, Bullfrog, Cal Spas, Master Spas, Marquis, Dimension One, Softub and Intex. Each match names the catalog page it comes from."
 jsonld={[{"@context":"https://schema.org","@type":"WebSite","@id":`${site}#website`,name:"MySpaFilter",url:site,inLanguage:"en-US",publisher:{"@id":organization["@id"]}},{"@context":"https://schema.org",...organization},{"@context":"https://schema.org","@type":"WebPage",url:site,name:"Spa Filter & Hot Tub Filter Cross Reference",dateModified:[fileDate('src/pages/index.astro'),dataDate()].sort().at(-1),isPartOf:{"@id":`${site}#website`}}]}>
<section class="hero">
<svg class="ripples" viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" fill="none" stroke="#8fb9b0" stroke-opacity=".16">{[60,110,170,240,320,410].map(r=><ellipse cx="690" cy="40" rx={r*1.25} ry={r*.8}/>)}</svg>
<div>
<h1>Spa and hot tub filter cross-reference</h1>
<p class="lede">Type the number molded into your old filter, such as a Sundance <code>6540-476</code>, a Unicel <code>C-8326</code> or a Pleatco <code>PTL47W</code>. No number left? Type the size, diameter × length, like <code>7 x 10-3/4</code> or <code>178 x 273 mm</code>. A spa brand or model works too.</p>
<form class="search" id="f" role="search"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="q" name="q" placeholder="Part number, size (7 x 10-3/4) or brand" autocomplete="off" aria-label="Part number, size, or spa brand and model"><button class="btn" id="go">Find filter</button></form>
<p class="try">Try <a href="/?q=6540-476">6540-476</a>, <a href="/?q=7+x+10-3%2F4">7 x 10-3/4</a> or <a href="/?q=Caldera">Caldera</a>.</p>
<p id="msg" aria-live="polite"></p>
<ul id="res" class="res" hidden></ul>
</div>
<figure class="endcap" aria-labelledby="endcap-cap">
<svg viewBox="0 0 240 150" fill="none" stroke="#e8d6b5" stroke-width="1.4" role="img" aria-label="Illustration of a filter end cap with the part number C-8326 printed in the center, surrounded by slowly swirling pleats">
<g aria-hidden="true">
<ellipse cx="120" cy="75" rx="100" ry="62"/>
<g transform="translate(120 75) scale(1 .62)">
<g class="wp-ripples" stroke="#8fb9b0" stroke-width="1.2" vector-effect="non-scaling-stroke"><circle class="rp rp1" r="92" vector-effect="non-scaling-stroke"/><circle class="rp rp2" r="92" vector-effect="non-scaling-stroke"/><circle class="rp rp3" r="92" vector-effect="non-scaling-stroke"/></g>
<g class="wp-spin wp-b" stroke="#8fb9b0" stroke-opacity=".3" stroke-width="1" stroke-linecap="round">{armsB.map(d=><path d={d} vector-effect="non-scaling-stroke"/>)}</g>
<g class="wp-spin wp-a" stroke="#d6e7e0" stroke-opacity=".34" stroke-width="1.3" stroke-linecap="round">{armsA.map(d=><path d={d} vector-effect="non-scaling-stroke"/>)}</g>
</g>
<ellipse cx="120" cy="75" rx="34" ry="21" fill="#0b3c40" stroke-opacity=".75"/>
</g>
<text x="120" y="80" fill="#fff" stroke="none" font-family="ui-monospace,monospace" font-size="13" font-weight="600" text-anchor="middle">C-8326</text></svg><figcaption id="endcap-cap">The part number is usually stamped or printed on the top end cap, or on a label inside the pleats.</figcaption></figure>
<style>
.endcap .wp-spin,.endcap .rp{transform-origin:0 0;will-change:transform}
.endcap .wp-a{animation:wp-cw 48s linear infinite}
.endcap .wp-b{animation:wp-ccw 80s linear infinite}
.endcap .rp{fill:none;opacity:0;transform:scale(.37);animation:wp-ripple 9s ease-out infinite}
.endcap .rp2{animation-delay:-3s}.endcap .rp3{animation-delay:-6s}
@keyframes wp-cw{to{transform:rotate(360deg)}}
@keyframes wp-ccw{to{transform:rotate(-360deg)}}
@keyframes wp-ripple{0%{transform:scale(.37);opacity:0}15%{opacity:.4}100%{transform:scale(1);opacity:0}}
@media (prefers-reduced-motion:reduce){.endcap .wp-spin,.endcap .rp{animation:none;will-change:auto}.endcap .rp{opacity:.22}.endcap .rp1{transform:scale(.55)}.endcap .rp2{transform:scale(.75)}.endcap .rp3{transform:scale(.95)}}
.try{margin:.85rem 0 0;color:#f7fbfa;font-size:.95rem}.try a{color:#fff;font-weight:700;text-decoration:underline}
</style>
</section>
<style is:global>
.res{list-style:none;padding:.4rem 0;margin:.4rem 0 0;background:#fff;color:var(--fg);border-radius:12px;max-width:36rem;max-height:22rem;overflow:auto}.res li{margin:0;padding:.45rem .9rem;border-bottom:1px solid var(--bd);font-size:.93rem;line-height:1.4}.res li:last-child{border-bottom:0}.res a{font-weight:650;color:var(--ac)}.res small{display:block;color:var(--mut)}
</style>
<h2 class="rule" data-reveal>Browse by spa brand</h2>
<ul class="grid">{brands().filter(b=>brandIndexable(b.slug)).map((b)=>{const l=filters.filter(f=>f.brandSlug===b.slug);return <li class="card" data-reveal><a href={`/${b.slug}/`}><b>{b.name}</b><p>{l.length} cartridge{l.length===1?"":"s"}</p></a></li>})}</ul>
<h2 class="rule" data-reveal>When to replace or clean</h2>
<ul class="grid">
<li class="card" data-reveal><a href="/tools/filter-schedule/">Replace and clean calculator</a><p>Published intervals from Hot Spring, Jacuzzi, Sundance, Unicel and Pleatco, turned into dates.</p></li>
<li class="card" data-reveal><a href="/tools/filter-reorder/">Replacement schedule for one cartridge</a><p>The interval that applies to your cartridge, with its cross-reference numbers.</p></li>
</ul>
<h2 class="rule" data-reveal>Sizing and fitting guides</h2>
<ul class="grid">{['how-to-find-your-spa-filter-size','hot-spring-filter-sizes-by-collection','open-end-vs-threaded-hot-tub-filters','caldera-filter-bottom-fittings','how-often-to-replace-hot-tub-filter','intex-and-bestway-inflatable-spa-filters'].map(s=>guides.find(g=>g.slug===s)!).map(g=><li class="card" data-reveal><a href={`/guides/${g.slug}/`} style="font-weight:650">{g.title}</a></li>)}</ul><p><a href="/guides/">All {guides.length} guides</a></p>
<p>Holiday 2026: <a href="/guides/black-friday-hot-tub-filter-and-spa-care/">Black Friday filters and spa care</a>, <a href="/guides/gifts-for-hot-tub-owners-2026/">gifts for hot tub owners</a>, and <a href="/guides/winter-spa-care/">winter spa care</a>. Published dates and shipping cutoffs only.</p>
<h2 class="rule" data-reveal>How a match is made</h2>
<p>Spa makers, Unicel, Pleatco and Filbur often number the same cartridge differently. Each cartridge page lines those numbers up from the published tables and links the catalog page. If a number is missing, or two catalogs disagree, the page says what is missing. Measure the old cartridge before you order: the <a href="/guide/">measuring guide</a> shows how.</p>
<script type="application/json" id="sdata" set:html={JSON.stringify(sdata)}></script>
<script>
import { search } from '../lib/search.mjs';
const D = JSON.parse(document.getElementById('sdata')!.textContent!);
const q = document.getElementById('q') as HTMLInputElement, m = document.getElementById('msg')!, ul = document.getElementById('res')!;
const esc = (t: string) => String(t ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);
const mm = (x: number) => Math.round(x * 25.4);
const fmt = (n: number) => `${+n.toFixed(2)}" (${mm(n)} mm)`;
const item = (r: any) => `<li><a href="${r.h}">${esc(r.n)}</a>${r.p ? ` · ${r.pp ? `<a href="${r.pp}">${esc(r.p)}</a>` : esc(r.p)}` : ''}<small>${esc(r.dt)} (${mm(r.d)} mm) × ${esc(r.lt)} (${mm(r.l)} mm)</small></li>`;
const run = () => {
  const v = q.value.trim(); const r = search(D.rows, D.brands, v);
  const rows = r.rows.slice(0, 40);
  let msg = '';
  if (r.kind === 'empty') { ul.hidden = true; m.textContent = ''; return; }
  if (r.kind === 'size') msg = `Size ${r.size.b == null ? fmt(r.size.a) + ' (diameter or length)' : fmt(r.size.a) + ' × ' + fmt(r.size.b)}, within 0.25" (6 mm): ${r.rows.length} cartridge${r.rows.length === 1 ? '' : 's'}. Same size is not the same filter; check both ends on the cartridge page.`;
  else if (r.kind === 'part') { const e = r.part.exact.length, t = r.part.token.length, pa = r.part.partialTotal; msg = e ? `${e} cartridge${e === 1 ? ' uses' : 's use'} that exact part number.${t ? ` ${t} more include it inside a longer number, which is not the same part.` : ''} Compare diameter, length and both ends before you order.` : t ? `No exact match. ${t} cartridge${t === 1 ? '' : 's'} include it inside a longer part number, which is not the same part.` : `No exact part number matched. ${pa} longer part number${pa === 1 ? ' contains' : 's contain'} what you typed. They are not a cross-reference for each other.`; }
  else if (r.kind === 'text') msg = `${r.brands.length ? `Brand: ${r.brands.map(([s, n]: any) => `<a href="/${s}/">${esc(n)}</a>`).join(', ')}. ` : ''}${r.rows.length} cartridge${r.rows.length === 1 ? '' : 's'} match.`;
  else msg = 'No match. Try the part number from the end cap, a size like 7 x 10-3/4, or a spa brand.';
  if (r.rows.length > rows.length) msg += ` Showing the first ${rows.length}.`;
  m.innerHTML = msg; ul.innerHTML = rows.map(item).join(''); ul.hidden = !rows.length;
};
document.getElementById('f')!.addEventListener('submit', (e) => { e.preventDefault(); run(); history.replaceState(null, '', q.value.trim() ? `/?q=${encodeURIComponent(q.value.trim())}` : '/'); });
const init = new URLSearchParams(location.search).get('q'); if (init) { q.value = init; run(); }
</script>
</Base>
