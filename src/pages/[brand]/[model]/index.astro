---
import Base from '../../../layouts/Base.astro';
import Cartridge from '../../../components/Cartridge.astro';
import Sources from '../../../components/Sources.astro';
import { filters, slug, partLabel, fitSrc, sqftText, isIndexable, modelHref, type Filter } from '../../../lib/data';
import { retailerLinks, outboundRel } from '../../../config/affiliate';
export function getStaticPaths(){ return filters.map(f=>({params:{brand:f.brandSlug,model:f.modelSlug},props:{f}})); }
const { f } = Astro.props as { f: Filter };
const site = Astro.site!.href; const url = new URL(Astro.url.pathname, site).href;
const eq = f.equivalents||{}; const d:any = f.dimensions; const pk = partLabel(f);
const oems = (f.oemAll||f.oem||'').split(';').map(s=>s.trim()).filter(Boolean);
const shops = retailerLinks(f.searchTerm || pk);
const amazon = shops.find(r=>r.id==='amazon');
const sameBrand = filters.filter(x=>x.brandSlug===f.brandSlug);
// "Other cartridges for this brand": nearest sizes first, indexable pages only, capped so the block stays a short, useful list.
const moreBrand = sameBrand.filter(x=>x!==f && isIndexable(x))
  .sort((a,b)=>(Math.abs(a.dimensions.diameterIn-d.diameterIn)*4+Math.abs(a.dimensions.lengthIn-d.lengthIn))-(Math.abs(b.dimensions.diameterIn-d.diameterIn)*4+Math.abs(b.dimensions.lengthIn-d.lengthIn))).slice(0,6);
// Same Unicel/Pleatco part listed under other brands (genuine "compatible / equivalent" links), indexable pages only.
const others = filters.filter(x=>x.brandSlug!==f.brandSlug && pk && partLabel(x)===pk && isIndexable(x)).slice(0,5);
const fit = f.fitment||[];
const fitGroups = [...new Set(fit.map(x=>x.src))];
const yrs = fit.flatMap(x=>(x.years.match(/\d{4}/g)||[]).map(Number));
const yrSpan = yrs.length ? `${Math.min(...yrs)}–${Math.max(...yrs)}` : '';
const LINES = ['Highlife','Limelight','Tiger River','Vacanza','Utopia','Paradise','Highland','Aquatic Melodies','C-Series'];
const series = LINES.filter(l=>fit.some(x=>x.src==='lt' && x.model.startsWith(l)));
const names = [eq.unicel&&`Unicel ${eq.unicel}`, eq.pleatco&&`Pleatco ${eq.pleatco}`, eq.filbur&&`Filbur ${eq.filbur}`].filter(Boolean) as string[];
// Rows with no catalog equivalent (e.g. inflatable-spa cartridges) are named by the maker's own cartridge type.
const shortNames = names.length ? names.map(n=>n.split(' ')[1]) : (f.label ? [f.label] : []);
if (!names.length && f.label) names.push(`${f.brand} ${f.label}`);
const sq = sqftText(d);
const oemTxt = oems.length ? `OEM ${oems.join(', ')}` : `the ${f.series} cartridge`;
const ld = [{"@context":"https://schema.org","@type":"Product",name:`${f.brand} ${f.model} spa filter`,...(f.oem?{mpn:f.oem}:{}),brand:{"@type":"Brand",name:f.brand},url,
  description:`Replacement hot tub filter for ${f.brand}: ${oemTxt}, ${names.join(', ')}.`},
 {"@context":"https://schema.org","@type":"BreadcrumbList",itemListElement:[
  {"@type":"ListItem",position:1,name:"Home",item:site},{"@type":"ListItem",position:2,name:f.brand,item:new URL(`/${f.brandSlug}/`,site).href},{"@type":"ListItem",position:3,name:f.model,item:url}]}];
---
<Base title={`${f.brand} ${f.oem||pk} Spa Filter – ${shortNames.slice(0,2).join(' / ')} Replacement`} description={`${f.brand} ${oemTxt} hot tub filter cross-reference: ${names.join(', ')}. ${d.diameterText} × ${d.lengthText}${sq?`, ${sq}`:''}${fit.length?`, fits ${fit.length} listed model${fit.length>1?'s':''}`:''}, with cited sources.`} jsonld={ld} noindex={f.index===false}>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href={`/${f.brandSlug}/`}>{f.brand}</a> › <span aria-current="page">{f.model}</span></nav>
<h1>{f.brand} {f.oem?`OEM ${f.oem} `:''}spa filter ({pk!==f.oem ? pk : (f.label||pk)})</h1>
<p>Listed for: {f.series}{f.status!=='verified' && <strong> — unverified</strong>}</p>
<section class="card answer"><div class="cols"><div>
<div class="kicker">Your replacement</div>
<div class="big">{names.slice(0,2).join(' · ')}</div>
<p style="margin:.2rem 0 .6rem">Fits {oems.length?`${f.brand} OEM ${oems.join(', ')}`:f.series} {f.status==='verified'?<span class="badge">cited</span>:<span class="badge u">unverified</span>}</p>
<span class="pill">Ø {d.diameterText}</span><span class="pill">L {d.lengthText}</span>{sq && <span class="pill">{sq}</span>}{fit.length>0 && <span class="pill">{fit.length} model{fit.length>1?'s':''} listed</span>}
<table style="margin-top:1rem"><tr><th>Unicel</th><td>{eq.unicel ? <a href={`/filter/${slug(eq.unicel)}/`}>{eq.unicel}</a> : 'not listed in Unicel 2026 guide'}</td></tr>
<tr><th>Pleatco</th><td>{eq.pleatco ? <a href={`/filter/${slug(eq.pleatco.split('/')[0])}/`}>{eq.pleatco}</a> : 'not found in source'}{f.pleatcoNote && <small> ({f.pleatcoNote})</small>}</td></tr>
<tr><th>Filbur</th><td>{eq.filbur ? <a href={`/filter/${slug(eq.filbur)}/`}>{eq.filbur}</a> : 'not found in Filbur catalog'}</td></tr>
<tr><th>Top</th><td>{d.topCore||'—'}</td></tr><tr><th>Bottom</th><td>{d.bottomCore||'—'}</td></tr></table>
<div class="buy">{shops.map((r)=><a class="btn" href={r.href} rel={outboundRel} target="_blank"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 4h2l2.4 11h11l2-8H6.2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>Check {r.name}</a>)}</div>
<p class="amz-note" data-amazon-disclosure><small>As an Amazon Associate I earn from qualifying purchases.{amazon && amazon.direct ? <> The Amazon button opens the {amazon.listing} listing.</> : <> The Amazon button opens an Amazon search for this part number.</>} FiltersFast and Doheny's buttons open retailer searches. Retailer links are affiliate links; see the <a href="/affiliate-disclosure/">disclosure</a>. Verify dimensions before ordering.</small></p>
</div><Cartridge d={d} /></div></section>
{f.notes && <p><strong>Source note:</strong> {f.notes}</p>}
{fit.length>0 && <>
<h2>Which {f.brand} hot tubs use this filter</h2>
<p>{fitGroups.includes('lt') ? `A spa dealer listing (Leisure Time Inc.) for this cartridge names ${fit.filter(x=>x.src==='lt').length} ${f.brand} model${fit.filter(x=>x.src==='lt').length>1?'s':''}${series.length?` across the ${series.join(', ')} line${series.length>1?'s':''}`:''}${yrSpan?`, with model years from ${yrSpan}`:''}. ` : ''}{fitGroups.includes('unicel') ? `The Unicel guide ties this spa filter to the ${f.brand} system${fit.filter(x=>x.src==='unicel').length>1?'s':''} shown below. ` : ''}{fitGroups.includes('pleatco') ? (fit.filter(x=>x.src==='pleatco').some(x=>x.years) ? 'The Pleatco catalog gives the production years shown below for the matching OEM number. ' : 'The Pleatco catalog names the systems shown below against the matching OEM number. ') : ''}{fitGroups.includes('hd') ? "The PureSpa model numbers below come from a retailer listing for the same Intex part; confirm against your spa's manual. " : ''}{fitGroups.includes('intex') ? `Intex's own replacement-part page for this cartridge lists the ${fit.filter(x=>x.src==='intex').length} inflatable hot tub set numbers below. Match the full set number on your spa's box or manual, including any letter suffix, because Intex has sold sets with near-identical numbers that take different cartridges. ` : ''}{fitGroups.includes('layzspa')||fitGroups.includes('bestway') ? "Bestway's own sites describe which of its inflatable hot tubs take this cartridge, as shown below; they do not print model-year lists. " : ''}{fitGroups.includes('spd') ? "A spa parts retailer's listing for the OEM part names the models below; it gives no model years. " : ''}A model name alone is not always enough: some hot tubs changed filter size mid-run, and dealers flag years where you should check the serial number or read the part number off the old cartridge first.</p>
<div class="tbl"><table><thead><tr><th>Model / system</th><th>Years</th><th>Listed by</th></tr></thead><tbody>
{fit.map(x=><tr><td>{x.model}{x.note && <small> ({x.note})</small>}</td><td>{x.years||'—'}</td><td>{fitSrc[x.src]}</td></tr>)}</tbody></table></div>
</>}
<h2>How to confirm this is your filter</h2>
<p>Pull your current cartridge and measure it end to end, including any handle, and across the widest point of the pleats. This cartridge measures {d.diameterText} in diameter and {d.lengthText} long{d.topCore ? `, with a ${d.topCore} top` : ''}{d.bottomCore ? ` and a ${d.bottomCore} bottom` : ''}. The bottom fitting matters most: a hot tub filter with the right diameter but the wrong thread or open-end size will not seal in the housing, letting unfiltered water bypass the media.</p>
<p>{sq ? `The ${sq} rating describes the pleated media area. ` : 'None of our sources gives a media-area (sq ft) rating for this cartridge, so compare it by size and part number. '}{f.brand} housings are designed around a particular cartridge, so choose a replacement with the same size and fittings rather than a larger area rating. {eq.unicel && eq.pleatco && !f.pleatcoNote ? `Unicel ${eq.unicel} and Pleatco ${eq.pleatco} are cross-referenced to each other in the Pleatco 2023 catalog, so either should fit the same housing.` : eq.pleatco ? `The Pleatco number shown comes from ${f.pleatcoNote ? 'the source noted beside it' : 'the Pleatco 2023 spec table'}, so match its size and fittings to your old cartridge before ordering.` : `We did not find a Pleatco equivalent for ${pk} in the Pleatco 2023 cross-reference, so search by the ${eq.unicel?'Unicel or ':''}${f.brand} part number.`}{eq.filbur ? ` Filbur ${eq.filbur} is the Filbur catalog's match${f.filburNote ? ' (see the source note in the list below)' : ''}.` : ''}{oems.length>1 ? ` ${f.brand} has used ${oems.length} OEM numbers for this cartridge; any of them should map to the same replacement spa filter.` : ''}</p>
{others.length>0 && <p>The same {pk} cartridge is also listed for {others.map((x,i)=><>{i>0?', ':''}<a href={modelHref(x)}>{x.brand}</a></>)}, so those pages are a handy second check on the part number.</p>}
{moreBrand.length>0 && <><h2>Other {f.brand} cartridges</h2><ul>{moreBrand.map(x=><li><a href={modelHref(x)}>{x.model}</a> — {(x.dimensions as any).diameterText} × {(x.dimensions as any).lengthText}</li>)}</ul>
<p><a href={`/${f.brandSlug}/`}>See all {sameBrand.length} {f.brand} spa filters →</a></p></>}
<Sources f={f} />
</Base>
