---
import Base from '../../../layouts/Base.astro';
import Cartridge from '../../../components/Cartridge.astro';
import Sources from '../../../components/Sources.astro';
import ProductPicks from '../../../components/ProductPicks.astro';
import { filters, slug, partLabel, fitSrc, sqftText, isIndexable, modelHref, type Filter } from '../../../lib/data';
import BuyLinks from '../../../components/BuyLinks.astro';
import { rowDate } from '../../../lib/lastmod';
import { SITE, publisherRef } from '../../../lib/schema';
import HolidayCta from '../../../components/HolidayCta.astro';
import ReminderForm from '../../../components/ReminderForm.astro';
import { holidayOnCartridge } from '../../../lib/holiday';
import { pages as fitPages } from '../../../lib/fitment';
export function getStaticPaths(){ return filters.map(f=>({params:{brand:f.brandSlug,model:f.modelSlug},props:{f}})); }
const { f } = Astro.props as { f: Filter };
const site = Astro.site!.href; const url = new URL(Astro.url.pathname, site).href;
const eq = f.equivalents||{}; const d:any = f.dimensions; const pk = partLabel(f);
const reminderModel = `${f.brand} ${f.model}`;
const reminderLabel = pk && !reminderModel.includes(pk) ? `${reminderModel} (${pk})` : reminderModel;
const oems = (f.oemAll||f.oem||'').split(';').map(s=>s.trim()).filter(Boolean);
const sameBrand = filters.filter(x=>x.brandSlug===f.brandSlug);
// "Other cartridges for this brand": nearest sizes first, indexable pages only, capped so the block stays a short, useful list.
const moreBrand = sameBrand.filter(x=>x!==f && isIndexable(x))
  .sort((a,b)=>(Math.abs(a.dimensions.diameterIn-d.diameterIn)*4+Math.abs(a.dimensions.lengthIn-d.lengthIn))-(Math.abs(b.dimensions.diameterIn-d.diameterIn)*4+Math.abs(b.dimensions.lengthIn-d.lengthIn))).slice(0,6);
// Same Unicel/Pleatco part listed under other brands (genuine "compatible / equivalent" links), indexable pages only.
const others = filters.filter(x=>x.brandSlug!==f.brandSlug && pk && partLabel(x)===pk && isIndexable(x)).slice(0,5);
const fit = f.fitment||[];
const fitGroups = [...new Set(fit.map(x=>x.src))];
const fitPage = fitPages.find(p=>p.brandSlug===f.brandSlug);
const yrs = fit.flatMap(x=>(x.years.match(/\d{4}/g)||[]).map(Number));
const yrSpan = yrs.length ? `${Math.min(...yrs)}–${Math.max(...yrs)}` : '';
const LINES = ['Highlife','Limelight','Tiger River','Vacanza','Utopia','Paradise','Highland','Aquatic Melodies','C-Series'];
const series = LINES.filter(l=>fit.some(x=>x.src==='lt' && x.model.startsWith(l)));
const names = [eq.unicel&&`Unicel ${eq.unicel}`, eq.pleatco&&`Pleatco ${eq.pleatco}`, eq.filbur&&`Filbur ${eq.filbur}`].filter(Boolean) as string[];
// Rows with no catalog equivalent (e.g. inflatable-spa cartridges) are named by the maker's own cartridge type.
const shortNames = names.length ? names.map(n=>n.split(' ')[1]) : (f.label ? [f.label] : []);
if (!names.length && f.label) names.push(`${f.brand} ${f.label}`);
const sq = sqftText(d);
const oemTxt = oems.length ? `OEM ${oems.join(', ')}` : `the ${f.series} cartridge`;
const pageTitle = `${f.brand} ${f.oem||pk} Spa Filter – ${shortNames.slice(0,2).join(' / ')} Replacement`;
const dim = `${d.diameterText} diameter × ${d.lengthText} long${d.topCore?`, top: ${d.topCore}`:''}${d.bottomCore?`, bottom: ${d.bottomCore}`:''}${sq?`, ${sq}`:''}`;
// Cross-reference entries: one per part number the cited catalogs treat as interchangeable. No offers, prices, ratings or reviews.
const partItems = [
  ...oems.map(o=>`${f.brand} OEM ${o}`),
  ...(eq.unicel?[`Unicel ${eq.unicel}`]:[]), ...(eq.pleatco?[`Pleatco ${eq.pleatco}`]:[]), ...(eq.filbur?[`Filbur ${eq.filbur}`]:[]),
];
const fitGuide: Record<string, [string, string]> = {
  'hot-spring': ['/guides/hot-spring-filter-sizes-by-collection/','Hot Spring filter sizes by collection'],
  'hot-spot': ['/guides/hot-spring-filter-sizes-by-collection/','Hot Spring filter sizes by collection'],
  'solana': ['/guides/hot-spring-filter-sizes-by-collection/','Hot Spring filter sizes by collection'],
  'caldera': ['/guides/caldera-filter-bottom-fittings/','Caldera filter bottoms'],
  'bullfrog': ['/guides/bullfrog-threaded-and-coreless-filters/','Bullfrog filters'],
  'intex': ['/guides/intex-and-bestway-inflatable-spa-filters/','Intex and Bestway filters'],
  'bestway': ['/guides/intex-and-bestway-inflatable-spa-filters/','Intex and Bestway filters'],
  'sundance': ['/guides/sundance-and-jacuzzi-look-alike-filters/','Sundance and Jacuzzi look-alike filters'],
  'jacuzzi': ['/guides/sundance-and-jacuzzi-look-alike-filters/','Sundance and Jacuzzi look-alike filters'],
  'master-spas': ['/guides/master-spas-eco-pur-filters/','Master Spas Eco-Pur filters'],
};
const fg = fitGuide[f.brandSlug];
const cites = (f.sources||[]).map(s=>({"@type":"CreativeWork",name:`${s.source}, ${s.where}`,url:s.url}));
const ld = [{"@context":"https://schema.org","@type":"WebPage","@id":`${url}#webpage`,name:pageTitle,url,
  description:`Cross-reference of ${f.brand} ${oemTxt} to ${names.join(', ')}. ${dim}.`,inLanguage:"en-US",dateModified:rowDate(f),
  isPartOf:{"@type":"WebSite",name:"MySpaFilter",url:SITE},publisher:publisherRef,
  about:{"@type":"Thing",name:`${f.brand} ${f.model}`,description:dim,...(partItems.length?{alternateName:partItems}:{})},
  mainEntity:{"@type":"ItemList",name:`Part numbers cross-referenced for ${f.brand} ${f.model}`,numberOfItems:partItems.length,itemListOrder:"https://schema.org/ItemListUnordered",
    itemListElement:partItems.map((name,i)=>({"@type":"ListItem",position:i+1,name}))},
  ...(cites.length?{citation:cites}:{}),
  breadcrumb:{"@id":`${url}#breadcrumb`}},
 {"@context":"https://schema.org","@type":"BreadcrumbList","@id":`${url}#breadcrumb`,itemListElement:[
  {"@type":"ListItem",position:1,name:"Home",item:site},{"@type":"ListItem",position:2,name:f.brand,item:new URL(`/${f.brandSlug}/`,site).href},{"@type":"ListItem",position:3,name:f.model,item:url}]}];
---
<Base title={pageTitle} description={`${f.brand} ${oemTxt} hot tub filter cross-reference: ${names.join(', ')}. ${d.diameterText} × ${d.lengthText}${sq?`, ${sq}`:''}${fit.length?`, fits ${fit.length} listed model${fit.length>1?'s':''}`:''}, with cited sources.`} jsonld={ld} noindex={f.index===false}>
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href={`/${f.brandSlug}/`}>{f.brand}</a> › <span aria-current="page">{f.model}</span></nav>
<h1>{f.brand} {f.oem?`OEM ${f.oem} `:''}spa filter ({pk!==f.oem ? pk : (f.label||pk)})</h1>
<p>Listed for: {f.series}{f.status!=='verified' && <strong> — unverified</strong>}</p>
<section class="card answer"><div class="cols"><div>
<div class="kicker">Your replacement</div>
<div class="big">{names.slice(0,2).join(' · ')}</div>
<p style="margin:.2rem 0 .6rem">Fits {oems.length?`${f.brand} OEM ${oems.join(', ')}`:f.series} {f.status==='verified'?<span class="badge">cited</span>:<span class="badge u">unverified</span>}</p>
<span class="pill">Ø {d.diameterText}</span><span class="pill">L {d.lengthText}</span>{sq && <span class="pill">{sq}</span>}{fit.length>0 && <span class="pill">{fit.length} model{fit.length>1?'s':''} listed</span>}
<BuyLinks filter={f} />
<table style="margin-top:1rem"><tr><th>Unicel</th><td>{eq.unicel ? <a href={`/filter/${slug(eq.unicel)}/`}>{eq.unicel}</a> : 'not listed in Unicel 2026 guide'}</td></tr>
<tr><th>Pleatco</th><td>{eq.pleatco ? <a href={`/filter/${slug(eq.pleatco.split('/')[0])}/`}>{eq.pleatco}</a> : 'not found in source'}{f.pleatcoNote && <small> ({f.pleatcoNote})</small>}</td></tr>
<tr><th>Filbur</th><td>{eq.filbur ? <a href={`/filter/${slug(eq.filbur)}/`}>{eq.filbur}</a> : 'not found in Filbur catalog'}</td></tr>
<tr><th>Top</th><td>{d.topCore||'—'}</td></tr><tr><th>Bottom</th><td>{d.bottomCore||'—'}</td></tr></table>
</div><Cartridge d={d} /></div></section>
{holidayOnCartridge(f.brandSlug, f.modelSlug) && <HolidayCta />}
<ReminderForm filterModel={reminderLabel} />
<ProductPicks heading="Keep this cartridge clean and your water in range" lead={`Unicel and Pleatco say a spa cartridge needs a hose rinse and a degreasing soak of at least an hour to keep flowing. Our guides cover the <a href="/guides/how-to-clean-a-hot-tub-filter/">cleaning steps</a>, <a href="/guides/best-hot-tub-filter-cleaners/">filter cleaners</a> and <a href="/guides/best-hot-tub-test-strips/">test strips</a>; a few picks are below.`} groups={[{h:'Filter cleaner and test strips',keys:['lt-filter-clean-o','spaguard-filter-cleaner','aquachek-spa-6in1']}]} />
{f.notes && <p><strong>Source note:</strong> {f.notes}</p>}
{fit.length>0 && <>
<h2>Which {f.brand} hot tubs use this filter</h2>
<p>{fitGroups.includes('lt') ? `A spa dealer listing (Leisure Time Inc.) for this cartridge names ${fit.filter(x=>x.src==='lt').length} ${f.brand} model${fit.filter(x=>x.src==='lt').length>1?'s':''}${series.length?` across the ${series.join(', ')} line${series.length>1?'s':''}`:''}${yrSpan?`, with model years from ${yrSpan}`:''}. ` : ''}{fitGroups.includes('unicel') ? `The Unicel guide ties this spa filter to the ${f.brand} system${fit.filter(x=>x.src==='unicel').length>1?'s':''} shown below. ` : ''}{fitGroups.includes('pleatco') ? (fit.filter(x=>x.src==='pleatco').some(x=>x.years) ? 'The Pleatco catalog gives the production years shown below for the matching OEM number. ' : 'The Pleatco catalog names the systems shown below against the matching OEM number. ') : ''}{fitGroups.includes('hd') ? "The PureSpa model numbers below come from a retailer listing for the same Intex part; confirm against your spa's manual. " : ''}{fitGroups.includes('intex') ? `Intex's own replacement-part page for this cartridge lists the ${fit.filter(x=>x.src==='intex').length} inflatable hot tub set numbers below${fit.some(x=>x.src==='intex'&&x.years) ? ", and the years are the model-year folders Intex's parts archive files the part under" : ''}. Match the full set number on your spa's box or manual, including any letter suffix, because Intex has sold sets with near-identical numbers that take different cartridges. ` : ''}{fitGroups.includes('bwcat')||fitGroups.includes('bwman') ? "Bestway's own catalogs and owner's manuals name the models below for this cartridge, by catalog or manual year; Bestway's stores describe the current range. " : (fitGroups.includes('layzspa')||fitGroups.includes('bestway') ? "Bestway's own sites describe which of its inflatable hot tubs take this cartridge, as shown below; they do not print model-year lists. " : '')}{fitGroups.includes('mqdealer') ? "Two spa dealer listings for the factory part name the swim spas below; we could not check them against a Marquis document. " : ''}{fitGroups.includes('spd') ? "A spa parts retailer's listing for the OEM part names the models below; it gives no model years. " : ''}{fitGroups.includes('marquis') ? "Marquis's own filter finder lists this factory part number for the series and model years below. " : ''}{fitGroups.includes('nordic') ? "Nordic Hot Tubs' own filter chart lists this factory cartridge for the models below. " : ''}{fitGroups.includes('arcticdealer') ? "An Arctic Spas dealer listing gives the factory part number and the build years below. " : ''}{fitGroups.includes('hto') ? "A spa parts retailer's listing for the factory part (Hot Tub Outpost) names the models and years below; we could not check them against a manufacturer document. " : ''}A model name alone is not always enough: some hot tubs changed filter size mid-run, and dealers flag years where you should check the serial number or read the part number off the old cartridge first.</p>
{fitPage && <p>To see which cartridge every other {f.brand} model and year takes, use the <a href={`/fitment/${fitPage.slug}/`}>{f.brand} filter by model and year</a> lookup.</p>}
<div class="tbl"><table><thead><tr><th>Model / system</th><th>Years</th><th>Listed by</th></tr></thead><tbody>
{fit.map(x=><tr><td>{x.model}{x.note && <small> ({x.note})</small>}</td><td>{x.years||'—'}</td><td>{fitSrc[x.src]}</td></tr>)}</tbody></table></div>
</>}
{fit.length===0 && fitPage && <p><strong>Know your {f.brand} model but not sure this is the cartridge?</strong> Check the <a href={`/fitment/${fitPage.slug}/`}>{f.brand} filter by model and year</a> lookup.</p>}
<h2>How to confirm this is your filter</h2>
<p>Pull your current cartridge and measure it end to end, including any handle, and across the widest point of the pleats. This cartridge measures {d.diameterText} in diameter and {d.lengthText} long{d.topCore ? `, with a ${d.topCore} top` : ''}{d.bottomCore ? ` and a ${d.bottomCore} bottom` : ''}. The bottom fitting matters most: a hot tub filter with the right diameter but the wrong thread or open-end size will not seal in the housing, letting unfiltered water bypass the media.</p>
<p>{sq ? `The ${sq} rating describes the pleated media area. ` : 'None of our sources gives a media-area (sq ft) rating for this cartridge, so compare it by size and part number. '}{f.brand} housings are designed around a particular cartridge, so choose a replacement with the same size and fittings rather than a larger area rating. {eq.unicel && eq.pleatco && !f.pleatcoNote ? `Unicel ${eq.unicel} and Pleatco ${eq.pleatco} are cross-referenced to each other in the Pleatco 2023 catalog, so either should fit the same housing.` : eq.pleatco ? `The Pleatco number shown comes from ${f.pleatcoNote ? 'the source noted beside it' : 'the Pleatco 2023 spec table'}, so match its size and fittings to your old cartridge before ordering.` : `We did not find a Pleatco equivalent for ${pk} in the Pleatco 2023 cross-reference, so search by the ${eq.unicel?'Unicel or ':''}${f.brand} part number.`}{eq.filbur ? ` Filbur ${eq.filbur} is the Filbur catalog's match${f.filburNote ? ' (see the source note in the list below)' : ''}.` : ''}{oems.length>1 ? ` ${f.brand} has used ${oems.length} OEM numbers for this cartridge; any of them should map to the same replacement spa filter.` : ''}</p>
{others.length>0 && <p>The same {pk} cartridge is also listed for {others.map((x,i)=><>{i>0?', ':''}<a href={modelHref(x)}>{x.brand}</a></>)}, so those pages are a handy second check on the part number.</p>}
{moreBrand.length>0 && <><h2>Other {f.brand} cartridges</h2><ul>{moreBrand.map(x=><li><a href={modelHref(x)}>{x.model}</a> — {(x.dimensions as any).diameterText} × {(x.dimensions as any).lengthText}</li>)}</ul>
<p><a href={`/${f.brandSlug}/`}>See all {sameBrand.length} {f.brand} spa filters →</a></p></>}
<p>Match the top and bottom, not only the diameter. <a href="/guides/open-end-vs-threaded-hot-tub-filters/">Open-end vs threaded filters</a> explains those fittings, and <a href="/guides/how-to-install-a-hot-tub-filter/">how to install a cartridge</a> covers power-off, the retainer, and not running the spa with the filter removed.{fg && <> For this brand, see <a href={fg[0]}>{fg[1]}</a>.</>} Catalog numbers are compared in <a href="/guides/how-filbur-unicel-and-pleatco-numbers-compare/">how Filbur, Unicel and Pleatco numbers compare</a>.</p>
<p><strong>When the measurements match,</strong> the same retailer link is repeated here.</p>
<BuyLinks filter={f} />
<Sources f={f} />
</Base>
