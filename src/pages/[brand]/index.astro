---
import Base from '../../layouts/Base.astro';
import { brands, filters, partLabel, brandIndexable, relatedBrands, isIndexable, modelHref } from '../../lib/data';
import ProductPicks from '../../components/ProductPicks.astro';
import { brandCopy } from '../../lib/brandcopy';
import { brandDate } from '../../lib/lastmod';
import { SITE, publisherRef } from '../../lib/schema';
export function getStaticPaths(){ return brands().map(b=>({params:{brand:b.slug},props:{b}})); }
const { b } = Astro.props as any; const list = filters.filter(f=>f.brandSlug===b.slug);
const nFit = list.filter(f=>(f.fitment||[]).length).length; const nFb = list.filter(f=>f.equivalents?.filbur).length;
const models = new Set(list.flatMap(f=>(f.fitment||[]).map(x=>x.model)));
const thin = list.filter(f=>f.index===false);
const copy = brandCopy[b.slug]||[];
const site = Astro.site!.href; const url = new URL(Astro.url.pathname, site).href;
const related = relatedBrands(b.slug);
// Name only the sources this brand's rows actually cite.
const srcNames = new Set(list.flatMap(f=>(f.sources||[]).map(s=>s.source)));
const cats = [['Unicel','the Unicel 2026 Replacement Guide'],['Pleatco','the Pleatco 2023 catalog'],['Filbur','the Filbur catalog']].filter(([k])=>[...srcNames].some(n=>n.startsWith(k))).map(([,t])=>t);
const web = [...srcNames].some(n=>!/^(Unicel|Pleatco|Filbur)/.test(n));
const srcList = [...cats, ...(web?['manufacturer and retailer pages']:[])];
const srcTxt = srcList.length>1 ? `${srcList.slice(0,-1).join(', ')} and ${srcList.at(-1)}` : srcList[0]||'cited sources';
const hasCat = cats.length>0;
const indexed = list.filter(isIndexable);
const brandGuides: Record<string, [string, string][]> = {
  'hot-spring': [['/guides/hot-spring-filter-sizes-by-collection/','Hot Spring filter sizes by collection'],['/guides/spas-that-use-more-than-one-filter/','Spas that hold more than one cartridge']],
  'hot-spot': [['/guides/hot-spring-filter-sizes-by-collection/','Hot Spring and Hot Spot filter sizes'],['/guides/spas-that-use-more-than-one-filter/','Spas that hold more than one cartridge']],
  'solana': [['/guides/hot-spring-filter-sizes-by-collection/','Hot Spring family filter sizes']],
  'caldera': [['/guides/caldera-filter-bottom-fittings/','Caldera filter bottoms: male slip vs open end'],['/guides/hot-spring-filter-sizes-by-collection/','Hot Spring sizes, including Vacanza cartridges shared with Caldera']],
  'bullfrog': [['/guides/bullfrog-threaded-and-coreless-filters/','Bullfrog threaded and coreless filters']],
  'intex': [['/guides/intex-and-bestway-inflatable-spa-filters/','Intex PureSpa S1 and S2 filters']],
  'bestway': [['/guides/intex-and-bestway-inflatable-spa-filters/','Bestway Type VI and Lay-Z-Spa filters']],
  'sundance': [['/guides/sundance-and-jacuzzi-look-alike-filters/','Sundance and Jacuzzi look-alike filters'],['/guides/spas-that-use-more-than-one-filter/','Pleated cartridges plus a MicroClean insert']],
  'jacuzzi': [['/guides/sundance-and-jacuzzi-look-alike-filters/','Sundance and Jacuzzi look-alike filters']],
  'master-spas': [['/guides/master-spas-eco-pur-filters/','Master Spas Eco-Pur filters'],['/guides/spas-that-use-more-than-one-filter/','Spas that hold more than one cartridge']],
  'softub': [['/guides/how-filbur-unicel-and-pleatco-numbers-compare/','How Filbur, Unicel and Pleatco numbers compare']],
};
const extraGuides = brandGuides[b.slug] || [];
const commonGuides: [string, string][] = [
  ['/guides/open-end-vs-threaded-hot-tub-filters/','Open-end vs threaded hot tub filters'],
  ['/guides/how-filbur-unicel-and-pleatco-numbers-compare/','How Filbur, Unicel and Pleatco numbers compare'],
  ['/guides/how-to-find-your-spa-filter-size/','How to find your spa filter size'],
  ['/guides/how-to-install-a-hot-tub-filter/','How to install a cartridge'],
].filter(([href]) => !extraGuides.some(([h]) => h === href));
const amazonSearches = list.filter((f) => partLabel(f)).slice(0, 4).map((f) => [f.model, `${partLabel(f)} spa filter`, `${(f.dimensions as any).diameterText} × ${(f.dimensions as any).lengthText}`] as [string, string, string]);
const ld = [{"@context":"https://schema.org","@type":"CollectionPage","@id":`${url}#webpage`,name:`${b.name} spa filter cross reference`,url,inLanguage:"en-US",dateModified:brandDate(b.slug),
  description:`${list.length} ${b.name} hot tub filter cartridge${list.length>1?'s':''} with part numbers, sizes and cited sources.`,
  isPartOf:{"@type":"WebSite",name:"MySpaFilter",url:SITE},publisher:publisherRef,breadcrumb:{"@id":`${url}#breadcrumb`},
  mainEntity:{"@type":"ItemList",name:`${b.name} spa filter cartridges`,numberOfItems:indexed.length,itemListElement:indexed.map((f,i)=>({"@type":"ListItem",position:i+1,name:`${f.brand} ${f.model}`,url:new URL(modelHref(f),site).href}))}},
 {"@context":"https://schema.org","@type":"BreadcrumbList","@id":`${url}#breadcrumb`,itemListElement:[{"@type":"ListItem",position:1,name:"Home",item:site},{"@type":"ListItem",position:2,name:`${b.name} spa filters`,item:url}]}];
---
<Base title={hasCat ? `${b.name} Spa Filter Cross Reference – OEM to Unicel, Pleatco & Filbur` : `${b.name} Spa Filter Guide – Part Numbers, Sizes & Compatible Hot Tubs`} description={`${list.length} ${b.name} hot tub filter cartridge${list.length>1?'s':''} with ${hasCat?'OEM part numbers, Unicel, Pleatco and Filbur equivalents, sizes':'part numbers, sizes'}${nFit?` and model-year fitment for ${models.size} models`:''}, each with cited sources.`} jsonld={ld} noindex={!brandIndexable(b.slug)}>
<h1>{b.name} spa filters</h1>
<p>{b.name} lists {list.length} hot tub filter cartridge{list.length===1?'':'s'} here, with the OEM, Unicel, Pleatco and Filbur numbers and the measured size of each. {nFit ? `${nFit} of them include model or model-year notes from the cited sources.` : 'Model years appear only when a cited source prints them.'} Open a cartridge for the fittings and the catalog page each number came from. Measure the old filter before you order.</p>
{copy.map(p=><p>{p}</p>)}
<p>This page lists {list.length} {b.name} replacement cartridge{list.length>1?'s':''} from {srcTxt}{nFit?`, plus model and model-year fitment for ${nFit} of them (${models.size} hot tub models in total)`:''}. {hasCat ? `${nFb} ha${nFb===1?'s':'ve'} a Filbur number. ` : ''} Find your spa filter by the OEM part number on the end cap, or measure it and compare sizes below.</p>
<ul class="brand-cards">{list.map((f:any)=><li><a class="brand-card" href={modelHref(f)}><b>{f.oemAll||partLabel(f)}</b><small>{f.equivalents?.unicel||'—'} · {f.dimensions.diameterText} × {f.dimensions.lengthText}</small><span>See replacement →</span></a></li>)}</ul>
<div class="tbl brand-table"><table><thead><tr><th>Cartridge</th><th>Unicel</th><th>Pleatco</th><th>Filbur</th><th>Size</th><th>Fits</th><th>Status</th></tr></thead><tbody>
{list.map((f:any)=><tr><td><a href={modelHref(f)}>{f.oemAll||partLabel(f)}</a>{!f.oemAll && <small> ({f.series})</small>}</td><td>{f.equivalents.unicel||'—'}</td><td>{f.equivalents.pleatco||'—'}</td><td>{f.equivalents.filbur||'—'}</td><td>{f.dimensions.diameterText} × {f.dimensions.lengthText}{f.dimensions.sqft!=null ? `, ${f.dimensions.sqft} sq ft` : ''}</td><td>{(f.fitment||[]).length?`${f.fitment.length} model${f.fitment.length>1?'s':''}`:'—'}</td><td>{f.status==='verified'?<span class="badge">cited</span>:<span class="badge u">unverified</span>}</td></tr>)}</tbody></table></div>
{['hot-spring','caldera','jacuzzi','sundance','bullfrog','master-spas'].includes(b.slug) && <p><strong>Know your model but not the part number?</strong> See <a href={`/fitment/${b.slug}-filter-by-model-year/`}>{b.name} filter by model and year</a>.</p>}
{thin.length>0 && <p><small>{thin.length} of these rows have too little sourced detail for a stand-alone page (for example, no OEM number or no second cross-reference), so their pages are kept out of search results and this table is the main reference for them.</small></p>}
{related.length>0 && <><h2>Brands that share cartridges with {b.name}</h2><ul>{related.map(r=><li><a href={`/${r.slug}/`}>{r.name}</a> — same part number{r.parts.length>1?'s':''} {r.parts.slice(0,4).join(', ')}{r.parts.length>4?' and more':''}</li>)}</ul></>}
<h2>Guides that apply to {b.name}</h2>
<ul>
{extraGuides.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
{commonGuides.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
<li><a href="/guides/">All guides</a></li>
</ul>
<ProductPicks heading={`Search ${b.name} part numbers on Amazon`} lead="Each button opens an Amazon search for that part number. The cartridge page is where the cited size and fittings are. Match those before you buy." groups={[{h:'Part numbers from this table', search: amazonSearches}]} />
<p><small>Model-year fitment comes only from the sources named on each cartridge page. Where no source lists models or years, we say so rather than guess.</small></p>
<style>
.brand-cards{display:none;list-style:none;padding:0;margin:1rem 0;gap:.75rem}
.brand-card{display:flex;flex-direction:column;gap:.25rem;background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:1rem 1.1rem;text-decoration:none;color:inherit;min-height:2.85rem}
.brand-card b{font-family:var(--hd);font-weight:400;font-size:1.15rem;color:var(--ink)}
.brand-card small{color:var(--mut)}
.brand-card span{color:var(--ac);font-weight:650;margin-top:.35rem}
@media (max-width:600px){.brand-cards{display:grid}.brand-table{display:none}}
</style>
</Base>
