---
import { cartridgeBuyLinks, outboundRel, type RetailerLink } from '../config/affiliate';
interface CartridgeRef {
  searchTerm?: string;
  oem?: string;
  oemAll?: string;
  equivalents?: { unicel?: string; pleatco?: string; filbur?: string };
}
interface Props { filter: CartridgeRef }
const { filter } = Astro.props as Props;
const links = cartridgeBuyLinks(filter);
const directs = links.filter((r) => r.id === 'amazon' && r.direct && r.listing);
const hasSearch = links.some((r) => r.id === 'amazon' && !r.direct);
const others = links.filter((r) => r.id !== 'amazon');
const label = (r: RetailerLink) => {
  if (r.id !== 'amazon') return `Search ${r.name}`;
  if (!r.direct) return 'Search on Amazon';
  return directs.length > 1 && r.listing ? `See ${r.listing} on Amazon` : 'See on Amazon';
};
---
{links.length > 0 && (
  <>
    <div class="buy">
      {links.map((r) => (
        <a class="btn" href={r.href} rel={outboundRel} target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 4h2l2.4 11h11l2-8H6.2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
          {label(r)}<span class="sr"> ({r.listing || r.name}, opens in a new tab)</span>
        </a>
      ))}
    </div>
    <p class="amz-note" data-amazon-disclosure><small>As an Amazon Associate I earn from qualifying purchases. {directs.length === 1 && <>See on Amazon opens the {directs[0].listing} listing we checked. </>}{directs.length > 1 && <>Each See on Amazon button opens the listing named on that button, which we checked. </>}{hasSearch && <>Search on Amazon opens an Amazon search for this part number, not one listing we pre-checked. </>}{others.length > 0 && <>{others.map((r) => r.name).join(' and ')} {others.length > 1 ? 'open' : 'opens'} a retailer search. </>}These are affiliate links. See the <a href="/affiliate-disclosure/">affiliate disclosure</a>. Verify dimensions before ordering.</small></p>
  </>
)}
