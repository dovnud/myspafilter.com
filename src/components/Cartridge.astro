---
const { d } = Astro.props as any;
const dia = d.diameterIn||7, len = d.lengthIn||10;
const scale = Math.min(260/len, 150/dia);
const W = dia*scale, H = len*scale, x = 200-W/2, y = 40;
const pleats = Math.max(8, Math.round(W/9));
---
<figure class="diagram" aria-label={`Cartridge diagram: ${d.diameterText} diameter, ${d.lengthText} long`}>
<svg viewBox={`-110 0 620 ${H+110}`} role="img">
<defs><linearGradient id="pl" x1="0" x2="1"><stop offset="0" stop-color="#e9dcc4"/><stop offset=".5" stop-color="#fbf6ec"/><stop offset="1" stop-color="#e1cfae"/></linearGradient></defs>
<rect x={x+W*.32} y={y-14} width={W*.36} height="14" rx="3" fill="#0b3c40"/>
<rect x={x} y={y} width={W} height="12" rx="4" fill="#135e63"/>
<rect x={x} y={y+12} width={W} height={H-24} fill="url(#pl)"/>
{Array.from({length:pleats}).map((_,i)=><line x1={x+(i+0.5)*W/pleats} x2={x+(i+0.5)*W/pleats} y1={y+12} y2={y+H-12} stroke="#c9b48e" stroke-width="1.2" class="pleat"/>)}
<rect x={x} y={y+H-12} width={W} height="12" rx="4" fill="#135e63"/>
<rect x={x+W*.32} y={y+H} width={W*.36} height="14" rx="3" fill="#0b3c40"/>
<g class="dim" stroke="#a5532a" stroke-width="1.5" fill="#a5532a" font-family="Public Sans Variable,system-ui" font-size="19" font-weight="700">
<line x1={x} x2={x+W} y1={y+H+34} y2={y+H+34}/><line x1={x} x2={x} y1={y+H+28} y2={y+H+40}/><line x1={x+W} x2={x+W} y1={y+H+28} y2={y+H+40}/>
<text x="200" y={y+H+56} text-anchor="middle" stroke="none">Ø {d.diameterText}</text>
<line x1={x+W+22} x2={x+W+22} y1={y} y2={y+H}/><line x1={x+W+16} x2={x+W+28} y1={y} y2={y}/><line x1={x+W+16} x2={x+W+28} y1={y+H} y2={y+H}/>
<text x={x+W+30} y={y+H/2+4} stroke="none">{d.lengthText}</text></g>
<g font-family="Public Sans Variable,system-ui" font-size="15" fill="#4f6466">
<text x={x-8} y={y-2} text-anchor="end">Top: {d.topCore||'—'}</text>
<text x={x-8} y={y+H+12} text-anchor="end">Bottom: {d.bottomCore||'—'}</text></g>
</svg><figcaption class="crumbs" style="text-align:center">Diagram drawn to scale from catalog dimensions · {d.sqft} sq ft media</figcaption></figure>
