---
import { brands, filters } from '../lib/data';
interface Props { title:string; description:string; jsonld?: object[]; noindex?: boolean }
const { title, description, jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const nav = [['/','Home'],['/size/','Size lookup'],['/guides/','Guides'],['/about/','About'],['/contact/','Contact']];
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"><link rel="preload" href="/fonts/young-serif-latin.woff2" as="font" type="font/woff2" crossorigin><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><meta name="description" content={description}>
<meta name="robots" content={noindex?"noindex,follow":"index,follow"}><link rel="canonical" href={canonical}><meta name="theme-color" content="#0b3c40">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%230b3c40'/%3E%3Cpath d='M12 4C10 7 8 9.5 8 13a4 4 0 0 0 8 0c0-3.5-2-6-4-9Z' fill='%23e8d6b5'/%3E%3C/svg%3E">
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical}><meta property="og:type" content="website">
{jsonld.map(j => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<style is:global>
@font-face{font-family:"Young Serif";src:url(/fonts/young-serif-latin.woff2) format("woff2");font-weight:400;font-style:normal;font-display:swap;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Public Sans Variable";src:url(/fonts/public-sans-latin-var.woff2) format("woff2-variations");font-weight:100 900;font-style:normal;font-display:swap;unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"PS Fallback";src:local("Arial"),local("ArialMT"),local("Arimo Regular"),local("Helvetica");size-adjust:101.19%;ascent-override:93.89%;descent-override:22.24%;line-gap-override:0%}
@font-face{font-family:"YS Fallback";src:local("Georgia"),local("Gelasio Regular");size-adjust:111.58%;ascent-override:93.74%;descent-override:32.8%;line-gap-override:0%}
:root{--fg:#13292b;--mut:#4c6163;--bg:#f5f2eb;--card:#fffdf8;--ac:#135e63;--ink:#0b3c40;--cel:#d6e7e0;--min:#8fb9b0;--sand:#e8d6b5;--sand2:#f1e7d3;--cedar:#9c4b22;--bd:#e0d8c8;--r:6px;--hd:"Young Serif","YS Fallback",Georgia,"Times New Roman",serif}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}html.lenis,html.lenis body{height:auto}.lenis.lenis-smooth{scroll-behavior:auto!important}
body{margin:0;font:16.5px/1.65 "Public Sans Variable","PS Fallback",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--fg);background:var(--bg)}
a{color:var(--ac);text-underline-offset:3px;text-decoration-thickness:1px}a:hover{color:var(--ink);text-decoration-thickness:2px}
h1,h2,h3,.logo{font-family:var(--hd);font-weight:400}
h1{font-size:clamp(1.9rem,4.6vw,3rem);line-height:1.08;letter-spacing:-.01em;margin:.4rem 0 .8rem}
h2{font-size:1.55rem;line-height:1.2;margin-top:2.6rem}h3{font-size:1.15rem;margin:.5rem 0 .3rem}
h2.rule{display:flex;align-items:baseline;gap:.8rem}h2.rule::after{content:"";flex:1;border-top:1px solid var(--bd)}
.wrap{max-width:1080px;margin:0 auto;padding:0 1.2rem}
header{background:var(--ink);color:#fff;position:sticky;top:0;z-index:10;border-bottom:3px solid var(--sand)}
header .wrap{display:flex;flex-wrap:wrap;gap:.4rem 1rem;align-items:center;justify-content:space-between;padding:.7rem 1.2rem}
.logo{display:flex;align-items:center;gap:.5rem;font-size:1.3rem;color:#fff;text-decoration:none}.logo span{color:var(--sand)}
nav{display:flex;flex-wrap:wrap;gap:.1rem}nav a{color:#d9ebe6;text-decoration:none;padding:.35rem .75rem;font-size:.93rem;font-weight:550;border-bottom:2px solid transparent}
nav a:hover,nav a[aria-current]{color:#fff;border-bottom-color:var(--min)}
.disc{background:var(--sand2);border-bottom:1px solid var(--bd);font-size:.84rem;color:#5c4422}.disc .wrap{padding:.45rem 1.2rem}.disc a{color:#5c4422}
main{padding:1.6rem 0 3.5rem;min-height:60vh}
.card{background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:1.3rem 1.5rem;margin:1rem 0}
.answer{border:0;background:var(--ink);color:#fff;padding:1.7rem;position:relative;border-left:6px solid var(--sand)}
.answer a{color:#fff}.answer th{color:#bfdcd6}.answer td,.answer th{border-color:#ffffff26}
.answer .kicker{text-transform:uppercase;letter-spacing:.14em;font-size:.74rem;font-weight:700;color:var(--sand)}
.answer .big{font-family:var(--hd);font-weight:400;font-size:clamp(1.6rem,5vw,2.4rem);line-height:1.1;margin:.2rem 0 .4rem}
.answer .pill{display:inline-block;border:1px solid #ffffff4d;border-radius:3px;padding:.1rem .6rem;margin:.2rem .3rem 0 0;font-size:.9rem;font-weight:600;font-variant-numeric:tabular-nums}
.big{font-size:1.6rem;font-weight:700}
.tbl{overflow-x:auto;background:var(--card);border:1px solid var(--bd);border-radius:var(--r)}
table{border-collapse:collapse;width:100%;font-size:.95rem;font-variant-numeric:tabular-nums}td,th{padding:.6rem .75rem;border-bottom:1px solid var(--bd);text-align:left;vertical-align:top}th{color:var(--mut);font-weight:650;white-space:nowrap}
thead th{background:#ece5d6;color:#4e3f28;font-size:.8rem;text-transform:uppercase;letter-spacing:.06em}
tbody tr:hover{background:#faf6ee}
.btn{display:inline-flex;align-items:center;gap:.45rem;padding:.72rem 1.2rem;margin:.45rem .45rem 0 0;border-radius:4px;background:var(--ac);color:#fff!important;text-decoration:none;font-weight:700;border:0;font-size:1rem;cursor:pointer;font-family:inherit}
.btn:hover{background:var(--ink)}
.btn.sand{background:var(--sand);color:#3b2a12!important}.btn.ghost{background:transparent;border:1px solid #ffffff80}.btn.ghost:hover{background:#ffffff14}
.buy{display:flex;flex-wrap:wrap;gap:.2rem;margin-top:1rem}
.buy .btn{background:var(--sand);color:#3b2a12!important}.buy .btn:first-child{background:var(--cedar);color:#fff!important}.buy .btn:hover{filter:brightness(1.07)}
.hero{position:relative;overflow:hidden;background:var(--ink);color:#fff;border-radius:var(--r);padding:3rem 2.2rem 3.2rem;margin:.4rem 0 2rem;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:2rem;align-items:center}
.hero .ripples{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.hero>*{position:relative}
.hero .eyebrow{font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--sand);font-weight:700;margin:0}
.hero h1{max-width:none;color:#fff;min-height:3.24em}@media (max-width:600px){.hero h1{min-height:3.24em}}.hero h1 em{font-style:normal;color:var(--sand)}.hero p.lede{font-size:1.1rem;color:#d3e7e2;max-width:38rem}
.hero code,.lede code{font:600 .95em ui-monospace,SFMono-Regular,Menlo,monospace;color:#fff;background:#ffffff17;padding:0 .3em;border-radius:3px}
.search{display:flex;gap:.5rem;background:#fffdf8;border-radius:5px;padding:.35rem;max-width:36rem;margin-top:1.2rem}
.search svg{flex:none;margin:.65rem 0 0 .55rem;color:var(--mut)}
.search input{flex:1;border:0;font-size:1.05rem;padding:.7rem .3rem;outline:0;width:auto;min-width:0;background:transparent;font-family:inherit}
.search .btn{margin:0;background:var(--cedar)}
#msg{color:#e8f4f1;min-height:1.4em}#msg a{color:var(--sand)}
.endcap{border:1px solid #ffffff2e;border-radius:var(--r);padding:1.1rem 1.2rem;font-size:.9rem;color:#cfe3de}
.endcap svg{width:100%;height:auto;display:block}.endcap p{margin:.5rem 0 0}
.stats{display:flex;flex-wrap:wrap;gap:1.6rem;margin-top:1.4rem;font-size:.9rem;color:#bcd8d2;align-items:end}.stats b{display:block;font-family:var(--hd);font-weight:400;font-size:1.7rem;color:#fff;font-variant-numeric:tabular-nums}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1rem;padding:0;list-style:none}
.grid .card{margin:0}
.tile{display:block;text-decoration:none;color:var(--fg)!important;min-height:132px;padding:1.2rem 1.3rem;border-top:4px solid var(--c)}
.tile b{font-family:var(--hd);font-weight:400;font-size:1.4rem;display:block;color:var(--fg)}.tile small{color:var(--mut);font-size:.88rem}.tile .go{display:block;margin-top:.9rem;font-weight:650;color:var(--ac);font-size:.9rem}
.spotlight-card.card{padding:0;border-radius:var(--r)}
.feat{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem;counter-reset:st}.feat .card{margin:0;border-top:2px solid var(--ac)}.feat .n{font-family:var(--hd);font-size:2rem;color:var(--min);line-height:1}
.badge{display:inline-block;font-size:.74rem;font-weight:700;padding:.1rem .5rem;border-radius:3px;background:#dcefe6;color:#0f5a3f}.badge.u{background:#f8e3cf;color:#7f3a0c}
.diagram{background:var(--card);color:var(--fg);border-radius:var(--r);padding:.8rem;margin-top:1rem}.diagram svg{width:100%;height:auto;display:block}
.cols{display:grid;grid-template-columns:1.2fr 1fr;gap:1.4rem;align-items:start}
footer{background:var(--ink);color:#b5d1cc;font-size:.9rem;padding:2.4rem 0;border-top:3px solid var(--sand)}footer a{color:#eef7f5;margin-right:1rem;display:inline-block;margin-bottom:.3rem}
.crumbs{font-size:.88rem;color:var(--mut)}.crumbs a{color:var(--mut)}
input{padding:.65rem .8rem;border:1px solid var(--bd);border-radius:4px;font-size:1rem;width:8rem;font-family:inherit}input.wide{width:100%;max-width:26rem}
@media (max-width:860px){.hero{grid-template-columns:minmax(0,1fr)}.endcap{display:none}}
@media (max-width:760px){.cols{grid-template-columns:1fr}}
@media (max-width:600px){header .wrap{padding:.55rem 1rem}nav{width:100%;overflow-x:auto;flex-wrap:nowrap}nav a{padding:.3rem .55rem;font-size:.88rem;white-space:nowrap}.hero{padding:2rem 1.2rem 2.2rem}.card{padding:1.1rem}.search .btn{padding:.7rem .9rem}.btn{width:100%;justify-content:center}.search .btn{width:auto}}
.answer sup a{color:var(--sand)}details summary{cursor:pointer}details.card{padding:.9rem 1.2rem}
:focus-visible{outline:2px solid var(--cedar);outline-offset:2px}
</style></head><body>
<header><div class="wrap"><a class="logo" href="/"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.5C9 7 6 10 6 14a6 6 0 0 0 12 0c0-4-3-7-6-11.5Z" fill="#e8d6b5"/><path d="M8.5 15.5c1.2 1 2.2 1 3.5 0s2.3-1 3.5 0" stroke="#0b3c40" stroke-width="1.6" stroke-linecap="round"/></svg><span style="color:#fff">MySpaFilter<span>.com</span></span></a><nav>{nav.map(([h,l])=><a href={h} aria-current={path===h?'page':undefined}>{l}</a>)}</nav></div></header>
<div class="disc"><div class="wrap">Disclosure: we may earn a commission from qualifying purchases made through retailer links on this site, at no extra cost to you. As an Amazon Associate we earn from qualifying purchases. <a href="/affiliate-disclosure/">Read our affiliate disclosure</a>.</div></div>
<main class="wrap"><slot /></main>
<footer><div class="wrap"><p><strong style="color:#fff">Brands:</strong> {brands().map(b=><a href={`/${b.slug}/`}>{b.name}</a>)}</p>
<p><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/guides/">Guides</a><a href="/guide/">Measuring guide</a><a href="/affiliate-disclosure/">Affiliate disclosure</a><a href="/disclaimer/">Disclaimer</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></p>
<p>MySpaFilter is independent and not affiliated with any hot tub manufacturer or filter brand. Cross-reference data comes from the Unicel 2026 Replacement Guide and Pleatco 2023 catalog ({filters.length} cartridges). Always check dimensions before buying.</p>
<p>© {new Date().getFullYear()} myspafilter.com</p></div></footer>
<script>
const rm=matchMedia('(prefers-reduced-motion: reduce)');
if(!rm.matches){const load=()=>import('../scripts/motion.ts');'requestIdleCallback' in window?requestIdleCallback(load,{timeout:2500}):setTimeout(load,1200);}
</script>
</body></html>
