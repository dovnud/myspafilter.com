import { brands, filters } from '../lib/data';
interface Props { title:string; description:string; jsonld?: object[]; noindex?: boolean; ogType?: 'website'|'article'; ogImage?: string; ogImageAlt?: string; modified?: string; canonical?: boolean }
const { title, description, jsonld = [], noindex = false, ogType = 'website', ogImage, ogImageAlt, modified, canonical: withCanonical = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
// Default share image, with a section variant by URL (all 1200x630 PNG in /public/og/, made by scripts/gen-og.py)
const section = path.startsWith('/guides/') ? 'guides' : path.startsWith('/supplies/') ? 'supplies' : path.startsWith('/data/') ? 'data' : (path.startsWith('/fitment/') || brands().some(b=>path.startsWith(`/${b.slug}/`))) ? 'brands' : 'default';
const ogAlt: Record<string,string> = { default:'MySpaFilter.com: spa and hot tub filter cross-reference by part number', guides:'MySpaFilter.com guides: hot tub filter and water-care answers', supplies:'MySpaFilter.com hot tub supplies guides', data:'MySpaFilter.com spa filter cartridge dataset: download CSV or JSON', brands:'MySpaFilter.com spa brand filter cross-reference' };
const image = new URL(ogImage || `/og/${section}.png`, Astro.site).href;
const imageAlt = ogImageAlt || ogAlt[section];
const proseRe = /^\/(guides\/[^/]+|fitment\/[^/]+|about|contact|privacy|terms|disclaimer|affiliate-disclosure|guide)\/$/;
const prose = proseRe.test(path);
const nav = [['/','Home'],['/size/','Size lookup'],['/tools/','Tools'],['/guides/','Guides'],['/supplies/','Supplies'],['/data/','Data'],['/about/','About'],['/contact/','Contact']];
