---
import { brands, filters } from '../lib/data';
interface Props { title:string; description:string; jsonld?: object[]; noindex?: boolean }
const { title, description, jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const nav = [['/','Home'],['/size/','Size lookup'],['/guides/','Guides'],['/about/','About'],['/contact/','Contact']];
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><meta name="description" content={description}>
<meta name="robots" content={noindex?"noindex,follow":"index,follow"}><link rel="canonical" href={canonical}><meta name="theme-color" content="#06343b">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>💧</text></svg>">
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical}><meta property="og:type" content="website">
{jsonld.map(j => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<style is:global>:root{--fg:#0e2a33;--mut:#55707a;--bg:#f7f3ec;--card:#fff;--ac:#0a6b74;--ac2:#14a6a6;--aq:#7fd6d0;--sand:#e9c99a;--sand2:#f3e4cc;--coral:#e07a4f;--bd:#e6ddcf;--r:18px;--hd:ui-rounded,"SF Pro Rounded","Nunito","Segoe UI Variable Display",system-ui,sans-serif}
*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}
body{margin:0;font:16.5px/1.65 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",sans-serif;color:var(--fg);background:var(--bg)}
a{color:var(--ac);text-underline-offset:3px;text-decoration-thickness:1.5px}a:hover{color:#064a51}
h1,h2,h3,.logo{font-family:var(--hd)}
h1{font-size:clamp(1.8rem,4.5vw,2.8rem);line-height:1.12;letter-spacing:-.025em;margin:.4rem 0 .8rem;font-weight:800}
h2{font-size:1.45rem;margin-top:2.4rem;letter-spacing:-.015em;font-weight:750}
.wrap{max-width:1080px;margin:0 auto;padding:0 1.2rem}
header{background:#06343bee;backdrop-filter:blur(8px);color:#fff;position:sticky;top:0;z-index:10}
header .wrap{display:flex;flex-wrap:wrap;gap:.4rem 1rem;align-items:center;justify-content:space-between;padding:.7rem 1.2rem}
.logo{display:flex;align-items:center;gap:.45rem;font-weight:800;font-size:1.25rem;color:#fff;text-decoration:none;letter-spacing:-.02em}.logo span{color:var(--sand);font-weight:700}
nav{display:flex;flex-wrap:wrap;gap:.15rem}nav a{color:#d5efec;text-decoration:none;padding:.38rem .8rem;border-radius:999px;font-size:.94rem;font-weight:600}
nav a:hover,nav a[aria-current]{background:#ffffff1f;color:#fff}
.disc{background:var(--sand2);border-bottom:1px solid var(--bd);font-size:.84rem;color:#6a4f2a}.disc .wrap{padding:.45rem 1.2rem}.disc a{color:#6a4f2a}
main{padding:1.6rem 0 3.5rem;min-height:60vh}
.card{background:var(--card);border:1px solid var(--bd);border-radius:var(--r);padding:1.3rem 1.5rem;margin:1rem 0;box-shadow:0 1px 2px #0e2a330a,0 8px 24px -12px #0e2a3322}
.answer{border:0;background:linear-gradient(160deg,#0a5f68,#0d8a8c);color:#fff;padding:1.6rem;position:relative;overflow:hidden}
.answer a{color:#fff}.answer th{color:#bfe9e5}.answer td,.answer th{border-color:#ffffff22}
.answer .kicker{text-transform:uppercase;letter-spacing:.12em;font-size:.75rem;font-weight:700;color:var(--sand)}
.answer .big{font-family:var(--hd);font-size:clamp(1.6rem,5vw,2.4rem);font-weight:800;line-height:1.1;margin:.2rem 0 .4rem}
.answer .pill{display:inline-block;background:#ffffff1c;border:1px solid #ffffff33;border-radius:999px;padding:.15rem .7rem;margin:.2rem .3rem 0 0;font-size:.9rem;font-weight:600}
.big{font-size:1.6rem;font-weight:700}
.tbl{overflow-x:auto;background:#fff;border:1px solid var(--bd);border-radius:var(--r)}
table{border-collapse:collapse;width:100%;font-size:.95rem}td,th{padding:.6rem .75rem;border-bottom:1px solid var(--bd);text-align:left;vertical-align:top}th{color:var(--mut);font-weight:650;white-space:nowrap}
thead th{background:#f1ebe0;color:#5b4a33;font-size:.82rem;text-transform:uppercase;letter-spacing:.05em}
tbody tr:hover{background:#fbf8f2}
.btn{display:inline-flex;align-items:center;gap:.45rem;padding:.72rem 1.2rem;margin:.45rem .45rem 0 0;border-radius:12px;background:var(--ac);color:#fff!important;text-decoration:none;font-weight:700;border:0;font-size:1rem;cursor:pointer;transition:transform .12s,box-shadow .12s;box-shadow:0 4px 14px -6px #0a6b74aa}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px -8px #0a6b74cc}
.btn.sand{background:var(--sand);color:#3b2a12!important;box-shadow:0 4px 14px -6px #b98a4aaa}.btn.ghost{background:#ffffff1a;border:1px solid #ffffff55;box-shadow:none}
.buy{display:flex;flex-wrap:wrap;gap:.2rem;margin-top:1rem}
.buy .btn{background:var(--sand);color:#3b2a12!important}.buy .btn:first-child{background:var(--coral);color:#fff!important}
.hero{position:relative;overflow:hidden;background:radial-gradient(120% 90% at 85% 0,#18b3ad 0,#0a6b74 45%,#063a42 100%);color:#fff;border-radius:28px;padding:3rem 2rem 5.5rem;margin:.4rem 0 2rem}
.hero h1{max-width:20ch;color:#fff}.hero p{font-size:1.12rem;color:#cdeeea;max-width:40rem}
.hero .wave{position:absolute;left:0;right:0;bottom:-2px;width:100%;height:90px}
.search{display:flex;gap:.5rem;background:#fff;border-radius:16px;padding:.4rem;max-width:36rem;box-shadow:0 14px 40px -14px #0009;margin-top:1.2rem}
.search svg{flex:none;margin:.65rem 0 0 .55rem;color:var(--mut)}
.search input{flex:1;border:0;font-size:1.08rem;padding:.7rem .3rem;outline:0;width:auto;min-width:0;background:transparent}
.search .btn{margin:0;background:var(--coral);box-shadow:none}
#msg{color:#e8f7f5;min-height:1.4em}#msg a{color:var(--sand)}
.stats{display:flex;flex-wrap:wrap;gap:1.4rem;margin-top:1.3rem;font-size:.92rem;color:#bfe6e2}.stats b{display:block;font-family:var(--hd);font-size:1.5rem;color:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1rem;padding:0;list-style:none}
.grid .card{margin:0;transition:transform .15s,box-shadow .15s}.grid .card:hover{transform:translateY(-3px)}
.tile{display:block;text-decoration:none;color:#fff!important;border:0;background:var(--c);position:relative;overflow:hidden;min-height:140px}
.tile b{font-family:var(--hd);font-size:1.35rem;display:block}.tile small{opacity:.85}.tile svg{position:absolute;right:-10px;bottom:-14px;opacity:.22}
.feat{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem}.feat .card{margin:0}.feat svg{color:var(--ac2)}
.badge{display:inline-block;font-size:.74rem;font-weight:700;padding:.12rem .55rem;border-radius:999px;background:#dff3ec;color:#0f6a49}.badge.u{background:#fde9d7;color:#9a4a12}
.diagram{background:#fff;color:var(--fg);border-radius:16px;padding:.8rem;margin-top:1rem}.diagram svg{width:100%;height:auto;display:block}
.cols{display:grid;grid-template-columns:1.2fr 1fr;gap:1.4rem;align-items:start}
footer{background:#06343b;color:#a9cbc8;font-size:.9rem;padding:2.4rem 0;position:relative}footer a{color:#e5f4f2;margin-right:1rem;display:inline-block;margin-bottom:.3rem}
.crumbs{font-size:.88rem;color:var(--mut)}.crumbs a{color:var(--mut)}
input{padding:.65rem .8rem;border:1px solid var(--bd);border-radius:12px;font-size:1rem;width:8rem}input.wide{width:100%;max-width:26rem}
@media (max-width:760px){.cols{grid-template-columns:1fr}}
@media (max-width:600px){header .wrap{padding:.55rem 1rem}nav{width:100%;overflow-x:auto;flex-wrap:nowrap}nav a{padding:.3rem .6rem;font-size:.88rem;white-space:nowrap}.hero{padding:2rem 1.2rem 4.5rem;border-radius:20px}.card{padding:1.1rem}.search .btn{padding:.7rem .9rem}.btn{width:100%;justify-content:center}.search .btn{width:auto}}
.answer sup a{color:var(--sand)}details summary{cursor:pointer}details.card{padding:.9rem 1.2rem}
</style></head><body>
<header><div class="wrap"><a class="logo" href="/"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.5C9 7 6 10 6 14a6 6 0 0 0 12 0c0-4-3-7-6-11.5Z" fill="#7fd6d0"/><path d="M8.5 15.5c1.2 1 2.2 1 3.5 0s2.3-1 3.5 0" stroke="#06343b" stroke-width="1.6" stroke-linecap="round"/></svg>MySpaFilter<span>.com</span></a><nav>{nav.map(([h,l])=><a href={h} aria-current={path===h?'page':undefined}>{l}</a>)}</nav></div></header>
<div class="disc"><div class="wrap">Disclosure: we may earn a commission from qualifying purchases made through retailer links on this site, at no extra cost to you. As an Amazon Associate we earn from qualifying purchases. <a href="/affiliate-disclosure/">Learn more</a>.</div></div>
<main class="wrap"><slot /></main>
<footer><div class="wrap"><p><strong style="color:#fff">Brands:</strong> {brands().map(b=><a href={`/${b.slug}/`}>{b.name}</a>)}</p>
<p><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/guides/">Guides</a><a href="/guide/">Measuring guide</a><a href="/affiliate-disclosure/">Affiliate disclosure</a><a href="/disclaimer/">Disclaimer</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></p>
<p>MySpaFilter is independent and not affiliated with any hot tub manufacturer or filter brand. Cross-reference data comes from the Unicel 2026 Replacement Guide and Pleatco 2023 catalog ({filters.length} cartridges). Always check dimensions before buying.</p>
<p>© {new Date().getFullYear()} myspafilter.com</p></div></footer>
</body></html>
